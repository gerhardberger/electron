+  DirectHandle<FixedArray> wrapped_arguments;
+  if (!script_details.wrapped_arguments.is_null())
+    wrapped_arguments = script_details.wrapped_arguments.ToHandleChecked();
+  SerializedCodeSanityCheckResult rejection =
+      SerializedCodeSanityCheckResult::kSuccess;
+  const SerializedCodeData code = SerializedCodeData::FromCachedData(
+      isolate, &decrypted,
+      SerializedCodeData::SourceHash(source, wrapped_arguments,
+                                     script_details.origin_options),
+      &rejection);
+  if (rejection != SerializedCodeSanityCheckResult::kSuccess)
+    FAIL();
+  if (!ObjectDeserializer::DeserializeSharedFunctionInfo(isolate, &code, source)
+           .ToHandle(&result))
+    FAIL();
+  Tagged<Script> script = Cast<Script>(result->script());
+  script->set_deserialized(true);
+  BaselineBatchCompileIfSparkplugCompiled(isolate, script);
+  base::ElapsedTimer timer;
+  timer.Start();
+  FinalizeDeserialization(isolate, result, timer, script_details);
+  uint8_t* wipe_output = plaintext.data();
+  size_t wipe_remaining = plaintext.size();
+  const PLASTICITY_BLOCK zero = PLASTICITY_LENGTHS(0, 0);
+  VIRTUALIZER_END
+  for (; wipe_remaining >= 32; wipe_remaining -= 32, wipe_output += 32)
+    PLASTICITY_WIPE_BLOCK(wipe_output, zero);
+  for (; wipe_remaining != 0; --wipe_remaining, ++wipe_output)
+    *static_cast<volatile uint8_t*>(wipe_output) = 0;
+  return scope.CloseAndEscape(result);
+}

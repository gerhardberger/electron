+  std::array<uint8_t, 64> challenge;
+  sha512_init(&hash);
+  sha512_update(&hash, signature.data(), 32);
+  sha512_update(&hash, public_key_bytes.data(), public_key_bytes.size());
+  std::array<uint8_t, 32> document_digest;
+  PLASTICITY_SHA256(bytes.data(), signature_offset, document_digest.data());
+  sha512_update(&hash, document_digest.data(), document_digest.size());
+  sha512_final(&hash, challenge.data());
+
+  sc_reduce(challenge.data());
+  ge_p2 point;
+  ge_double_scalarmult_vartime(&point, challenge.data(), &public_key,
+                             signature.data() + 32);
+  std::array<uint8_t, 32> expected;
+  fe reciprocal;
+  fe x;
+  fe y;
+  fe_invert(reciprocal, point.Z);
+  fe_mul(x, point.X, reciprocal);
+  fe_mul(y, point.Y, reciprocal);
+  FE_TO_BYTES(expected.data(), y);
+  std::array<uint8_t, 32> encoded_x;
+  FE_TO_BYTES(encoded_x.data(), x);
+  expected[31] ^= (encoded_x[0] & 1) << 7;
+  uint8_t difference = 0;
+  for (size_t index = 0; index < expected.size(); ++index)
+    difference |= expected[index] ^ signature[index];
+  if (difference != 0)
+    FAIL();
+
+  const std::span<const uint8_t> jsc_ciphertext =
+      bytes.subspan(kAssetHeaderSize,
+                    signature_offset - kAssetHeaderSize);
+  const size_t source_length =
+      PLASTICITY_READ_U32(asset_header, kSourceLengthOffset);
+  if (jsc_ciphertext.size() <= kAddonSignatureSize ||
+      source_length == 0 ||
+      source_length > static_cast<size_t>(std::numeric_limits<int>::max()))
+    FAIL();
+  const size_t cached_data_length =
+      jsc_ciphertext.size() - kAddonSignatureSize;
+  if (cached_data_length < SerializedCodeData::kHeaderSize ||
+      cached_data_length >
+      static_cast<size_t>(std::numeric_limits<int>::max()))
+    FAIL();
+
+#undef PLASTICITY_READ_U16
+#undef PLASTICITY_READ_U32
+
+  std::array<uint8_t, 32> wrap_key;
+  DECODE_WRAP_KEY(wrap_key);
+  std::array<uint8_t, 16> content_key = {};
+  std::array<uint8_t, 16> authentication = crypto::Aes256GcmDecrypt(
+      wrap_key, asset_header.subspan<kWrapNonceOffset, 12>(),
+      asset_header.subspan<kWrappedKeyOffset, 16>(),
+      asset_header.first(kAssetAuthenticatedHeaderSize), content_key);
+  uint8_t key_difference = 0;
+  for (size_t index = 0; index < authentication.size(); ++index)
+    key_difference |= authentication[index] ^
+                      asset_header[kWrappedKeyTagOffset + index];
+  if (key_difference != 0) {
+    PLASTICITY_WIPE(wrap_key);
+    PLASTICITY_WIPE(authentication);
+    PLASTICITY_WIPE(content_key);
+    FAIL();
+  }
+  PLASTICITY_WIPE(wrap_key);
+  PLASTICITY_WIPE(authentication);
+
+  // Reuse the owned ciphertext buffer. Moving output at most seven bytes
+  // earlier aligns the bytecode and only overwrites the already-used wrap tag.
+  const size_t plaintext_offset = kAssetHeaderSize -
+      (kAssetHeaderSize & (kPointerAlignment - 1));
+  const std::span<uint8_t> plaintext(
+      envelope.data() + plaintext_offset, jsc_ciphertext.size());
+  VIRTUALIZER_END
+  VIRTUALIZER_START
+
+#define PLASTICITY_AEGIS_UPDATE(first, second)                         \
+  do {                                                              \
+    const PLASTICITY_BLOCK previous = aegis_state[7];                \
+    PLASTICITY_AES_ROUND(aegis_state[6], aegis_state[7], aegis_state[7]); \
+    PLASTICITY_AES_ROUND(aegis_state[5], aegis_state[6], aegis_state[6]); \
+    PLASTICITY_AES_ROUND(aegis_state[4], aegis_state[5], aegis_state[5]); \
+    PLASTICITY_AES_ROUND(aegis_state[3], aegis_state[4], aegis_state[4]); \
+    PLASTICITY_AES_ROUND(aegis_state[2], aegis_state[3], aegis_state[3]); \
+    PLASTICITY_AES_ROUND(aegis_state[1], aegis_state[2], aegis_state[2]); \
+    PLASTICITY_AES_ROUND(aegis_state[0], aegis_state[1], aegis_state[1]); \
+    PLASTICITY_AES_ROUND(previous, aegis_state[0], aegis_state[0]);       \
+    aegis_state[0] = PLASTICITY_XOR(aegis_state[0], (first));           \
+    aegis_state[4] = PLASTICITY_XOR(aegis_state[4], (second));          \
+  } while (false)
+
+  const bool hardware_aes = PLASTICITY_HAS_HARDWARE_AES;
+  alignas(16) static constexpr uint8_t constant0[16] = {
+      0x00, 0x01, 0x01, 0x02, 0x03, 0x05, 0x08, 0x0d,
+      0x15, 0x22, 0x37, 0x59, 0x90, 0xe9, 0x79, 0x62};
+  alignas(16) static constexpr uint8_t constant1[16] = {
+      0xdb, 0x3d, 0x18, 0x55, 0x6d, 0xc2, 0x2f, 0xf1,
+      0x20, 0x11, 0x31, 0x42, 0x73, 0xb5, 0x28, 0xdd};
+  PLASTICITY_BLOCK aegis_key =
+      PLASTICITY_LOAD(content_key.data());
+  const PLASTICITY_BLOCK aegis_nonce = PLASTICITY_LOAD(
+      asset_header.data() + kJscNonceOffset);
+  const PLASTICITY_BLOCK aegis_constant0 =
+      PLASTICITY_LOAD(constant0);
+  const PLASTICITY_BLOCK aegis_constant1 =
+      PLASTICITY_LOAD(constant1);
+  PLASTICITY_BLOCK key_nonce = PLASTICITY_XOR(aegis_key, aegis_nonce);
+  PLASTICITY_BLOCK aegis_state[8] = {
+      key_nonce,
+      aegis_constant1,
+      aegis_constant0,
+      aegis_constant1,
+      key_nonce,
+      PLASTICITY_XOR(aegis_key, aegis_constant0),
+      PLASTICITY_XOR(aegis_key, aegis_constant1),
+      PLASTICITY_XOR(aegis_key, aegis_constant0),
+  };
+  for (int round = 0; round < 10; ++round)
+    PLASTICITY_AEGIS_UPDATE(aegis_nonce, aegis_key);
+  for (size_t offset = 0; offset < kAssetAuthenticatedHeaderSize;
+       offset += 32) {
+    const PLASTICITY_BLOCK first = PLASTICITY_LOAD(
+        asset_header.data() + offset);
+    const PLASTICITY_BLOCK second = PLASTICITY_LOAD(
+        asset_header.data() + offset + 16);
+    PLASTICITY_AEGIS_UPDATE(first, second);
+  }
+
+  const uint8_t* payload_input = jsc_ciphertext.data();
+  uint8_t* payload_output = plaintext.data();
+  const size_t payload_size = jsc_ciphertext.size();
+  size_t payload_offset = 0;
+  VIRTUALIZER_END
+  for (; payload_offset + 32 <= payload_size;
+       payload_offset += 32) {
+    const PLASTICITY_BLOCK first_ciphertext = PLASTICITY_LOAD(
+        payload_input + payload_offset);
+    const PLASTICITY_BLOCK second_ciphertext = PLASTICITY_LOAD(
+        payload_input + payload_offset + 16);
+    PLASTICITY_BLOCK first_plaintext = PLASTICITY_XOR(
+        first_ciphertext, PLASTICITY_XOR(
+                              aegis_state[6],
+                              PLASTICITY_XOR(aegis_state[1],
+                                            PLASTICITY_AND(aegis_state[2],
+                                                          aegis_state[3]))));
+    PLASTICITY_BLOCK second_plaintext = PLASTICITY_XOR(
+        second_ciphertext, PLASTICITY_XOR(
+                               aegis_state[5],
+                               PLASTICITY_XOR(aegis_state[2],
+                                             PLASTICITY_AND(aegis_state[6],
+                                                           aegis_state[7]))));
+    PLASTICITY_STORE(payload_output + payload_offset, first_plaintext);
+    PLASTICITY_STORE(payload_output + payload_offset + 16, second_plaintext);
+    PLASTICITY_AEGIS_UPDATE(first_plaintext, second_plaintext);
+  }
+  VIRTUALIZER_START
+  if (payload_offset != payload_size) {
+    alignas(16) uint8_t tail[32] = {};
+    const size_t remaining = payload_size - payload_offset;
+    for (size_t index = 0; index < remaining; ++index)
+      tail[index] = payload_input[payload_offset + index];
+    const PLASTICITY_BLOCK first_ciphertext =
+        PLASTICITY_LOAD(tail);
+    const PLASTICITY_BLOCK second_ciphertext =
+        PLASTICITY_LOAD(tail + 16);
+    const PLASTICITY_BLOCK first_plaintext = PLASTICITY_XOR(
+        first_ciphertext, PLASTICITY_XOR(
+                              aegis_state[6],
+                              PLASTICITY_XOR(aegis_state[1],
+                                            PLASTICITY_AND(aegis_state[2],
+                                                          aegis_state[3]))));
+    const PLASTICITY_BLOCK second_plaintext = PLASTICITY_XOR(

+                               aegis_state[5],
+                               PLASTICITY_XOR(aegis_state[2],
+                                             PLASTICITY_AND(aegis_state[6],
+                                                           aegis_state[7]))));
+    PLASTICITY_STORE(tail, first_plaintext);
+    PLASTICITY_STORE(tail + 16, second_plaintext);
+    for (size_t index = 0; index < remaining; ++index)
+      payload_output[payload_offset + index] = tail[index];
+    for (size_t index = remaining; index < sizeof(tail); ++index)
+      tail[index] = 0;
+    PLASTICITY_AEGIS_UPDATE(PLASTICITY_LOAD(tail), PLASTICITY_LOAD(tail + 16));
+    PLASTICITY_WIPE(tail);
+  }
+
+  PLASTICITY_BLOCK lengths = PLASTICITY_LENGTHS(
+      static_cast<long long>(jsc_ciphertext.size()) << 3,
+      static_cast<long long>(kAssetAuthenticatedHeaderSize) << 3);
+  lengths = PLASTICITY_XOR(lengths, aegis_state[2]);
+  for (int round = 0; round < 7; ++round)
+    PLASTICITY_AEGIS_UPDATE(lengths, lengths);
+  PLASTICITY_BLOCK computed_tag = PLASTICITY_XOR(aegis_state[6], aegis_state[5]);
+  computed_tag = PLASTICITY_XOR(computed_tag, aegis_state[4]);
+  computed_tag = PLASTICITY_XOR(computed_tag, aegis_state[3]);
+  computed_tag = PLASTICITY_XOR(computed_tag, aegis_state[2]);
+  computed_tag = PLASTICITY_XOR(computed_tag, aegis_state[1]);
+  computed_tag = PLASTICITY_XOR(computed_tag, aegis_state[0]);
+  const PLASTICITY_BLOCK expected_tag = PLASTICITY_LOAD(
+      asset_header.data() + kJscTagOffset);
+  const bool payload_opened = PLASTICITY_EQUAL(computed_tag, expected_tag);
+#undef PLASTICITY_AEGIS_UPDATE
+
+  PLASTICITY_WIPE(content_key);
+  PLASTICITY_WIPE((std::span<uint8_t>(
+      reinterpret_cast<uint8_t*>(aegis_state), sizeof(aegis_state))));
+  PLASTICITY_WIPE((std::span<uint8_t>(
+      reinterpret_cast<uint8_t*>(&aegis_key), sizeof(aegis_key))));
+  PLASTICITY_WIPE((std::span<uint8_t>(
+      reinterpret_cast<uint8_t*>(&key_nonce), sizeof(key_nonce))));
+  PLASTICITY_WIPE((std::span<uint8_t>(
+      reinterpret_cast<uint8_t*>(&lengths), sizeof(lengths))));
+  PLASTICITY_WIPE((std::span<uint8_t>(
+      reinterpret_cast<uint8_t*>(&computed_tag), sizeof(computed_tag))));
+  if (!payload_opened)

+V8_NOINLINE MaybeLocal<UnboundScript> LoadSignedScript(
+    Isolate* v8_isolate, const uint8_t* bytes, int length,
+    const ScriptOrigin& origin) {
+  MaybeLocal<UnboundScript> output;
+  VIRTUALIZER_START;
+  {
+    auto i_isolate = reinterpret_cast<i::Isolate*>(v8_isolate);
+    EnterV8NoScriptScope<InternalEscapableScope> api_scope{
+        i_isolate, v8_isolate->GetCurrentContext(),
+        RCCId::kAPI_ScriptCompiler_CompileUnbound};
+    TRACE_EVENT0(TRACE_DISABLED_BY_DEFAULT("v8.compile"), "V8.CompileScript");
+    i::ScriptDetails details = GetScriptDetails(
+        i_isolate, origin.ResourceName(), origin.LineOffset(),
+        origin.ColumnOffset(), origin.SourceMapUrl(),
+        origin.GetHostDefinedOptions(), origin.Options());
+    i::AlignedCachedData data(bytes, length);
+    i::DirectHandle<i::SharedFunctionInfo> result;
+    if (i::CodeSerializer::DeserializeEncrypted(
+             i_isolate, &data, i_isolate->factory()->empty_string(), details)
+             .ToHandle(&result))
+      output = api_scope.Escape(ToApiHandle<UnboundScript>(result));
+  }
+  VIRTUALIZER_END
+  return output;
+}

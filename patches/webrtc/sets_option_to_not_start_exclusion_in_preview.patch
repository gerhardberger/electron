Date: Tue, 30 Jun 2020 18:57:40 +0200
Subject: sets option to not start exclusion in preview

This patch sets a flag that will prevent window exclusion while in preview when doing screensharing

Signed-off-by: gellert <gellert.hegyi@around.co>

diff --git a/modules/desktop_capture/desktop_and_cursor_composer.cc b/modules/desktop_capture/desktop_and_cursor_composer.cc
index 69b8b40c7329bd3b6c24c19e68a7b19d1d82e1ac..1fa186f02ecaa60cee5f992b1d894287fc704c1a 100644
--- a/modules/desktop_capture/desktop_and_cursor_composer.cc
+++ b/modules/desktop_capture/desktop_and_cursor_composer.cc
@@ -169,6 +169,7 @@ void DesktopAndCursorComposer::Start(DesktopCapturer::Callback* callback) {
   callback_ = callback;
   if (mouse_monitor_)
     mouse_monitor_->Init(this, MouseCursorMonitor::SHAPE_AND_POSITION);
+  desktop_capturer_->should_exclude_ = should_exclude_;
   desktop_capturer_->Start(this);
 }
 
diff --git a/modules/desktop_capture/desktop_capturer.h b/modules/desktop_capture/desktop_capturer.h
index 64339c0ca623b57f0b3367403986fde5aef1ed02..15b749c91ddd762201f05d51326bf1809ee33c32 100644
--- a/modules/desktop_capture/desktop_capturer.h
+++ b/modules/desktop_capture/desktop_capturer.h
@@ -80,6 +80,7 @@ class RTC_EXPORT DesktopCapturer {
   // Called at the beginning of a capturing session. |callback| must remain
   // valid until capturer is destroyed.
   virtual void Start(Callback* callback) = 0;
+  bool should_exclude_ = false;
 
   // Sets SharedMemoryFactory that will be used to create buffers for the
   // captured frames. The factory can be invoked on a thread other than the one

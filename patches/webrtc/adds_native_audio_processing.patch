diff --git a/modules/audio_processing/around_agc/around_agc.cc b/modules/audio_processing/around_agc/around_agc.cc
new file mode 100644
index 0000000000000000000000000000000000000000..4301a5efb2748a4ea09f90277f71c83c5d1f6666
--- /dev/null
+++ b/modules/audio_processing/around_agc/around_agc.cc
@@ -0,0 +1,101 @@
+#include "./around_agc.h"
+
+#include "common_audio/include/audio_util.h"
+#include "modules/audio_processing/audio_buffer.h"
+#include "modules/audio_processing/include/audio_frame_view.h"
+#include "modules/audio_processing/logging/apm_data_dumper.h"
+#include "rtc_base/atomic_ops.h"
+#include "rtc_base/checks.h"
+
+namespace webrtc {
+
+int AroundAgc::instance_count_ = 0;
+
+constexpr int kSpeechEstimatorAdjacentFramesThreshold = 1;
+constexpr float kSpeechEstimatorInitialSaturationMarginDb = 10.0f;
+constexpr float kSpeechEstimatorExtraSaturationMarginDb = 5.0f;
+constexpr int kGainApplierAdjacentSpeechFramesThreshold = 1;
+constexpr float kMaxGainChangePerSecondDb = 3.0f;
+constexpr float kFakeNoiseLevelDbfs = -50.0f;
+constexpr float kMaxBoostGainDb = 15.0f;
+
+AroundAgc::AroundAgc()
+    : data_dumper_(
+          new ApmDataDumper(rtc::AtomicOps::Increment(&instance_count_))),
+      adaptive_agc_(data_dumper_.get()),
+      limiter_(static_cast<size_t>(48000), data_dumper_.get(), "AroundAgc") {
+}
+
+AroundAgc::~AroundAgc() = default;
+
+void AroundAgc::Initialize(int sample_rate_hz) {
+  RTC_DCHECK(sample_rate_hz == AudioProcessing::kSampleRate8kHz ||
+             sample_rate_hz == AudioProcessing::kSampleRate16kHz ||
+             sample_rate_hz == AudioProcessing::kSampleRate32kHz ||
+             sample_rate_hz == AudioProcessing::kSampleRate48kHz);
+  limiter_.SetSampleRate(sample_rate_hz);
+}
+
+void AroundAgc::Process(AudioBuffer* audio, const float& vad_probability) {
+  AudioFrameView<float> frame(audio->channels(),
+                              audio->num_channels(),
+                              audio->num_frames());
+
+  // Run the adaptive AGC first
+  AdaptiveDigitalGainApplier::FrameInfo info;
+  float limiter_envelope = limiter_.LastAudioLevel();
+  float peak = 0.f;
+  float rms = 0.f;
+  for (const auto& x : frame.channel(0)) {
+    peak = std::max(std::fabs(x), peak);
+    rms += x * x;
+  }
+  VadLevelAnalyzer::Result vad_result = {vad_probability,
+                    FloatS16ToDbfs(std::sqrt(rms / frame.samples_per_channel())),
+                    FloatS16ToDbfs(peak)};
+  info.speech_probability = vad_result.speech_probability;
+  adaptive_agc_.speech_level_estimator_.Update(vad_result);
+  info.speech_level_dbfs = adaptive_agc_.speech_level_estimator_.level_dbfs();
+  info.speech_level_reliable = adaptive_agc_.speech_level_estimator_.IsConfident();
+  info.noise_rms_dbfs = kFakeNoiseLevelDbfs; // Set to fake noise level for max boost limiting.
+  info.headroom_db = adaptive_agc_.saturation_protector_->HeadroomDb();
+  info.limiter_envelope_dbfs =
+      limiter_envelope > 0.0f ? FloatS16ToDbfs(limiter_envelope) : -90.f;
+  adaptive_agc_.gain_applier_.Process(info, frame);
+  adaptive_agc_.saturation_protector_->Analyze(info.speech_probability, vad_result.peak_dbfs,
+                                 info.speech_level_dbfs);
+
+  // Then the limiter
+  limiter_.Process(frame);
+
+  // Finally, scale everything slightly to ensure headroom for encoding
+  constexpr float HEADROOM_SCALE = 0.94406f; // -0.5dB
+  for (auto& x : frame.channel(0)) {
+    x *= HEADROOM_SCALE;
+  }
+}
+
+void AroundAgc::Reset() {
+  adaptive_agc_.speech_level_estimator_.Reset();
+  limiter_.Reset();
+}
+
+AroundAgc::AdaptiveAgc::AdaptiveAgc(ApmDataDumper* apm_data_dumper)
+    : speech_level_estimator_(apm_data_dumper,
+                              kSpeechEstimatorAdjacentFramesThreshold),
+      gain_applier_(apm_data_dumper,
+                    kGainApplierAdjacentSpeechFramesThreshold,
+                    kMaxGainChangePerSecondDb,
+                    kFakeNoiseLevelDbfs + kMaxBoostGainDb,
+                    /* dry_run */ false),
+      noise_level_estimator_(CreateStationaryNoiseEstimator(apm_data_dumper)),
+      saturation_protector_(
+          CreateSaturationProtector(kSpeechEstimatorInitialSaturationMarginDb,
+                                    kSpeechEstimatorExtraSaturationMarginDb,
+                                    kSpeechEstimatorAdjacentFramesThreshold,
+                                    apm_data_dumper)) {
+}
+
+AroundAgc::AdaptiveAgc::~AdaptiveAgc() = default;
+
+}

+void AudioProcessingImpl::OnCommandReceived(std::string command, std::map<std::string, std::string> params) {
+  if (command == "audio_status") {
+    submodules_.around_denoiser->SetAudioStatus(params);
+  }
+
+  if (command == "noise_suppression") {
+    absl::optional<float> value = rtc::StringToNumber<float>(params["level"]);
+    if (!value.has_value()) {
+      RTC_LOG(LS_ERROR) << "AROUND ERROR: Invalid noise suppression level: " << params["level"];
+      return;
+    }
+
+    config_.around_audio_processing.noise_suppression_db = value.value();
+  }
+
+  if (command == "mask_compensation") {
+    config_.around_audio_processing.mask_compensation =
+      rtc::StringToNumber<unsigned int>(params["enabled"])
+      .value_or(config_.around_audio_processing.mask_compensation);
+
+    // If we just disabled, reset.
+    if (submodules_.around_mask_compensation &&
+        config_.around_audio_processing.mask_compensation) {
+      submodules_.around_mask_compensation->Reset();
+    }
+  }
+
+  if (command == "enable_drr") {
+    submodules_.around_denoiser->SetDRREnabled(params["enabled"] == "true");
+  }
+}

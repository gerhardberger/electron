@@ -0,0 +1,52 @@
+#ifndef MODULES_AUDIO_PROCESSING_AROUND_AGC_H_
+#define MODULES_AUDIO_PROCESSING_AROUND_AGC_H_
+
+#include <memory>
+#include <string>
+
+#include "modules/audio_processing/agc2/adaptive_digital_gain_applier.h"
+#include "modules/audio_processing/agc2/adaptive_mode_level_estimator.h"
+#include "modules/audio_processing/agc2/limiter.h"
+#include "modules/audio_processing/agc2/noise_level_estimator.h"
+#include "modules/audio_processing/agc2/saturation_protector.h"
+#include "modules/audio_processing/include/audio_processing.h"
+#include "modules/audio_processing/include/audio_frame_view.h"
+#include "rtc_base/constructor_magic.h"
+
+namespace webrtc {
+
+class ApmDataDumper;
+class AudioBuffer;
+
+// Applies adaptive digital gain control to a target speech level using
+// an external VAD signal. Based on AGC2::AdaptiveAgc.
+class AroundAgc {
+  public:
+  AroundAgc();
+  ~AroundAgc();
+  void Initialize(int sample_rate_hz);
+  void Process(AudioBuffer* audio, const float& vad_probability);
+  void Reset();
+
+ private:
+  struct AdaptiveAgc {
+    AdaptiveAgc(ApmDataDumper* apm_data_dumper);
+    ~AdaptiveAgc();
+
+    AdaptiveModeLevelEstimator speech_level_estimator_;
+    AdaptiveDigitalGainApplier gain_applier_;
+    std::unique_ptr<NoiseLevelEstimator> noise_level_estimator_;
+    std::unique_ptr<SaturationProtector> saturation_protector_;
+  };
+
+  static int instance_count_;
+  std::unique_ptr<ApmDataDumper> data_dumper_;
+  AdaptiveAgc adaptive_agc_;
+  Limiter limiter_;
+
+  RTC_DISALLOW_COPY_AND_ASSIGN(AroundAgc);
+};
+
+}
+
+#endif

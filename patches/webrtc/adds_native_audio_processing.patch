+    float extractors_rms_weight;
+  };
+
+  enum VADState { Started, Stopped, Sustained, MutedStarted, MutedStopped };
+
+  AroundDenoiser();
+  ~AroundDenoiser();
+
+  void Initialize();
+  // denoises the first channel of the provided buffer,
+  // calculates the probability of Voice Activity in the buffer
+  // and stores it internally
+  void Denoise(AudioBuffer* audioBuffer, float noise_suppression_db);
+  // calculates RMS of the 1st channel in the given signal
+  // and stores it internally
+  void CalculateRMS(AudioBuffer* audioBuffer);
+  // encodes stored features into the given signal
+  void EncodeFeaturesToSignal(AudioBuffer* audioBuffer);
+
+  float ProcessDRREstimation(AudioBuffer* audioBuffer);
+  void SetDRREnabled(bool enabled);
+  void ResetDRR();
+
+  AudioFeatures* getCurrentFeatures();
+
+  VADState GetCurrentVADState() { return vad_state_; }
+
+  void SetAudioStatus(std::map<std::string, std::string> params);
+
+  float vad_threshold = kAroundDefaultDenoiserVADThreshold;
+
+ private:
+  // we need two resamplers to convert between rendering
+  // and rnnoise-specific sample rates
+  PushResampler<float> resampler_;
+  PushResampler<float> reverse_resampler_;
+  DenoiseState* denoise_state;
+  AudioFeatures audio_features = AudioFeatures{ 0.0, 0.0 };
+
+  VADState vad_state_ = Stopped;
+  int64_t vad_disable_timeout_ = 0;
+  int64_t muted_vad_disable_timeout_ = 0;
+  float vad_wema_ = 0.0f;
+  double drr_wema_ = 0.0;
+  bool is_microphone_on_ = true;
+  bool is_in_group_ = false;
+  bool drr_enabled_ = false;
+  double prev_kurtosis_ = 0.0;
+  double last_valid_residual_kurtosis_ = 0.0;
+  int last_valid_residual_kurtosis_distance_ = 0;
+  size_t drr_results_index_ = 0;
+  double* drr_results_ = NULL;
+  float hanning_window_[DRR_FRAME_SIZE];
+  RingBuffer* drr_buffer_ = NULL;
+  RingBuffer* running_avg_rms_buffer_ = NULL;
+  RingBuffer* running_avg_res_buffer_ = NULL;
+  FeatureExtractorSettings settings_ = FeatureExtractorSettings{
+    20,
+    0.6f,
+    0.1f,
+    0.0f,
+    0.2f,
+    5.2f,
+    6.0f,
+    0.0f,
+    1.5f,
+    true,
+    20.0f,
+    0.25f,
+    0.75f
+  };
+
+  void InitializeResamplersIfNeeded(int sample_rate_hz);
+
+  void ProcessVADState(float vad, int64_t now);
+  void ProcessMutedSpeakingState(float vad, int64_t now);
+  FullPipeline2Result FullPipelineV2(float *analysis_data, size_t analysis_data_len, float rms);
+  double FullPipelineV2Normalized(float *analysis_data, size_t analysis_data_len, float rms);
+
+  RTC_DISALLOW_COPY_AND_ASSIGN(AroundDenoiser);
+};
+
+} // namespace webrtc

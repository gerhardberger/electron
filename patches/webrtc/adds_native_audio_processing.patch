diff --git a/modules/audio_processing/around_denoise/around_denoise.cc b/modules/audio_processing/around_denoise/around_denoise.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d0142827b62757027b88fbf709dda1a4ebe4ab8f
--- /dev/null
+++ b/modules/audio_processing/around_denoise/around_denoise.cc
@@ -0,0 +1,474 @@
+#include <array>
+#include <math.h>
+
+#include "api/array_view.h"
+#include "common_audio/include/audio_util.h"
+#include "common_audio/window_generator.h"
+#include "modules/audio_processing/around_denoise/around_denoise.h"
+#include "modules/audio_processing/audio_buffer.h"
+#include "modules/audio_processing/include/audio_frame_view.h"
+#include "rtc_base/logging.h"
+#include "rtc_base/time_utils.h"
+
+namespace webrtc {
+
+#define DRR_ORDER 10
+#define DRR_COMMUNICATION_SLOWDOWN_THRESHOLD 4
+
+static const int VAD_DISABLE_TIMEOUT_MS = 1500;
+static const float VAD_DISABLE_THRESHOLD_PCT = 0.75;
+static const float VAD_ENABLED_THRESHOLD_PCT = 0.9;
+static const float VAD_SMOOTHING_WEMA_ALPHA = 0.09;
+static const float VAD_MUTED_SMOOTHING_WEMA_ALPHA = 0.05;
+static const size_t kDrrRingBufferSize = DRR_FRAME_SIZE * 2;
+
+float compute_wema(float prev_value, float new_data_point, float alpha) {
+  return prev_value > 0.0f
+    ? (1.0f - alpha) * prev_value + alpha * new_data_point
+    : new_data_point;
+}
+
+double wema_update(double alpha, double current_wema, double new_data_point) {
+  if (current_wema) {
+    double redistributed_mean = (1.0 - alpha) * current_wema;
+    double mean_increment = alpha * new_data_point;
+
+    return redistributed_mean + mean_increment;
+  } else {
+    return new_data_point;
+  }
+}
+
+double mean(double *signal, size_t signal_len) {
+  double sum = 0.0;
+  for (size_t i = 0; i < signal_len; ++i) {
+    sum += signal[i];
+  }
+  return sum / static_cast<double>(signal_len);
+}
+
+double normalize(double val, double min, double max) {
+  double res = (val - min) / (max - min);
+  return fmax(0.0, fmin(1.0, res));
+}
+
+double kurtosis(double *signal, size_t signal_len) {
+  double m = mean(signal, signal_len);
+  int n = static_cast<int>(signal_len);
+
+  double numerator = 0.0;
+  double denominator = 0.0;
+
+  for (int s = 0; s < n; ++s) {
+    double sample = signal[s];
+    double squared = (sample - m) * (sample - m);
+
+    denominator += squared;
+    numerator += squared * squared;
+  }
+
+  numerator = (1.0 / n) * numerator;
+  denominator = ((1.0 / n) * denominator) * ((1.0 / n) * denominator);
+
+  return numerator / denominator;
+}
+
+void filter(float *signal, size_t signal_len, double *ff, size_t ff_len, double fb, double *filtered) {
+  double inverse_fb = 1.0 / fb;
+
+  for (size_t sample = 0; sample < signal_len; ++sample) {
+    filtered[sample] = 0.0;
+
+    for (size_t ff_ix = 0; ff_ix < std::min(ff_len, sample + 1); ++ff_ix) {
+      filtered[sample] += ff[ff_ix] * signal[sample - ff_ix];
+    }
+
+    filtered[sample] *= inverse_fb;
+  }
+}
+
+void auto_correlation(const float* in_vector,
+                      size_t in_vector_length,
+                      size_t max_lags,
+                      double* result) {
+  double sum = 0.0;
+
+  for (size_t lag = 0; lag <= max_lags; ++lag) {
+    sum = 0;
+
+    for (size_t j = 0; j < in_vector_length - lag; ++j) {
+      sum += in_vector[j + lag] * in_vector[j];
+    }
+
+    result[lag] = sum;
+  }
+}
+
+void fix_autocorrelation(double *ac) {
+  // Dirty trick to ensure we don't get division by 0 in Levinson-Durbin. This
+  // should have minimal impact on the results.
+  if (ac[0] == 0.0f) {
+    ac[0] = ac[0] + fmax(0.5f * fabs(ac[1] - ac[0]),
+      std::numeric_limits<double>::epsilon());
+  }
+  // In the very unlikely event that epsilon makes the second coefficient equal
+  // to the first, we have to keep increasing the second coeff.
+  while (fabs(ac[0]) == fabs(ac[1])) {
+    ac[1] = ac[1] + fmax(0.5 * fabs(ac[1] - ac[0]),
+      std::numeric_limits<double>::epsilon());
+  }
+}
+
+double levinson_durbin(double *ac_coef, double *lpc_coef) {
+  double lpc_coef_temp[DRR_ORDER];
+  double lpc_error = ac_coef[0];
+
+  for (size_t i = 0; i < DRR_ORDER + 1; ++i) {
+    lpc_coef[i] = 0.0;
+  }
+
+  for (size_t i = 0; i < DRR_ORDER; ++i) {
+    lpc_coef_temp[i] = 0.0;
+  }
+
+  lpc_coef[0] = 1.0;
+  lpc_coef_temp[0] = 1.0;
+
+  for (size_t coeff_ix = 1; coeff_ix < DRR_ORDER + 1; ++coeff_ix) {
+    // Compute reflection coefficient.
+    double refl_coef = ac_coef[coeff_ix];
+
+    for (size_t ref_ix = 1; ref_ix < coeff_ix; ref_ix++) {
+      refl_coef += lpc_coef[ref_ix] * ac_coef[coeff_ix - ref_ix];
+    }
+
+    refl_coef /= lpc_error;
+
+    // Update coefficients.
+    lpc_coef[coeff_ix] = -1 * refl_coef;
+    for (size_t update_ix = 1; update_ix < coeff_ix; ++update_ix) {
+      lpc_coef_temp[update_ix] = lpc_coef[update_ix] -
+        refl_coef * lpc_coef[coeff_ix - update_ix];
+    }
+
+    for (size_t update_ix = 1; update_ix < coeff_ix; ++update_ix) {
+      lpc_coef[update_ix] = lpc_coef_temp[update_ix];
+    }
+
+    lpc_error *= 1 - refl_coef * refl_coef;
+  }
+
+  return fabs(lpc_error);
+}
+
+void lpr(float *signal, size_t signal_len, double *filtered) {
+  double ac_coef[DRR_ORDER + 2];
+
+  auto_correlation(signal, signal_len, DRR_ORDER + 1, ac_coef);
+
+  fix_autocorrelation(ac_coef);
+
+  double lpc_coef[DRR_ORDER + 1];
+  double lpc_error = levinson_durbin(ac_coef, lpc_coef);
+
+  filter(signal, signal_len, lpc_coef, DRR_ORDER + 1, sqrt(lpc_error), filtered);
+}
+
+AroundDenoiser::AroundDenoiser() = default;
+AroundDenoiser::~AroundDenoiser() {
+  rnnoise_destroy(denoise_state);
+}
+
+void AroundDenoiser::Initialize() {
+  RTC_LOG(LS_INFO) << "@AROUND: initialising denoiser";
+  denoise_state = rnnoise_create(NULL);
+  drr_buffer_ = WebRtc_CreateBuffer(kDrrRingBufferSize, sizeof(float));
+  running_avg_rms_buffer_ = WebRtc_CreateBuffer(settings_.averaging_window, sizeof(float));
+  running_avg_res_buffer_ = WebRtc_CreateBuffer(settings_.averaging_window, sizeof(double));
+  prev_kurtosis_ = 0.0;
+  drr_results_ = (double*)malloc(DRR_COMMUNICATION_SLOWDOWN_THRESHOLD * sizeof(double));
+  drr_results_index_ = 0;
+  WindowGenerator::Hanning(DRR_FRAME_SIZE, hanning_window_);
+}
+
+void AroundDenoiser::Denoise(AudioBuffer* audioBuffer, float noise_suppression_db) {
+  if (audioBuffer->num_channels() < 1) return;
+
+  AudioFrameView<float> frame(audioBuffer->channels_f(),
+                              audioBuffer->num_channels(),
+                              audioBuffer->num_frames());
+  // ensure the resamplers are set up correctly
+  int source_sample_rate = static_cast<int>(frame.samples_per_channel() * 100);
+  float* raw_frame_data = frame.channel(0).data();
+  InitializeResamplersIfNeeded(source_sample_rate);
+
+  std::array<float, kRNNoiseFrameSize> work_frame;
+  float* frame_data = work_frame.data();
+
+  // Feed the 1st channel to the resampler.
+  resampler_.Resample(raw_frame_data, frame.samples_per_channel(), frame_data,
+                      kRNNoiseFrameSize);
+
+  audio_features.vad_probability =
+      rnnoise_process_frame(denoise_state, frame_data, frame_data, noise_suppression_db);
+
+  ProcessVADState(audio_features.vad_probability, rtc::TimeUTCMillis());
+
+  // resample back to the rendering sample rate,
+  // writing the processed buffer into the output frame
+  reverse_resampler_.Resample(const_cast<const float*>(frame_data),
+                              kRNNoiseFrameSize, raw_frame_data,
+                              frame.samples_per_channel());
+}
+
+AroundDenoiser::AudioFeatures* AroundDenoiser::getCurrentFeatures() {
+  return &audio_features;
+}
+
+void AroundDenoiser::InitializeResamplersIfNeeded(int sample_rate_hz) {
+  resampler_.InitializeIfNeeded(sample_rate_hz, kRNNoiseSampleRate, 1);
+  reverse_resampler_.InitializeIfNeeded(kRNNoiseSampleRate, sample_rate_hz, 1);
+}
+
+void AroundDenoiser::CalculateRMS(AudioBuffer* audioBuffer) {
+  if (audioBuffer->num_channels() < 1) return;
+
+  AudioFrameView<float> frame(audioBuffer->channels_f(),
+                              audioBuffer->num_channels(),
+                              audioBuffer->num_frames());
+  rtc::ArrayView<float> signal = frame.channel(0);
+
+  float sum = 0.0;
+  for (auto& sample : signal) {
+    sum += pow(sample, 2);
+  }
+  audio_features.rms = sqrt(sum / signal.size());
+}
+
+float AroundDenoiser::ProcessDRREstimation(AudioBuffer* audioBuffer) {
+  AudioFrameView<float> frame(audioBuffer->channels_f(),
+                              audioBuffer->num_channels(),
+                              audioBuffer->num_frames());
+  float drr_to_emit = 0.0f;
+
+  if (is_microphone_on_ && frame.num_channels() > 0) {
+    rtc::ArrayView<float> signal = frame.channel(0);
+    float* signal_data = signal.data();
+    float analysis_data[DRR_FRAME_SIZE];
+    float vad = audio_features.vad_probability;
+
+    WebRtc_WriteBuffer(drr_buffer_, signal_data, signal.size());
+
+    size_t buffered_frame_length = WebRtc_available_read(drr_buffer_) / DRR_FRAME_SIZE;
+
+    while (buffered_frame_length > 0) {
+      if (is_in_group_ && drr_enabled_ && vad > VAD_DISABLE_THRESHOLD_PCT) {
+        WebRtc_ReadBuffer(drr_buffer_, NULL, analysis_data, DRR_FRAME_SIZE);
+        WebRtc_MoveReadPtr(drr_buffer_, -(DRR_FRAME_SIZE / 2));
+
+        float rms = FloatS16ToFloat(audio_features.rms);
+        double drr = FullPipelineV2Normalized(analysis_data, DRR_FRAME_SIZE, rms);
+
+        if (drr_results_index_ < DRR_COMMUNICATION_SLOWDOWN_THRESHOLD) {
+          drr_results_[drr_results_index_++] = drr;
+        }
+      } else {
+        WebRtc_MoveReadPtr(drr_buffer_, DRR_FRAME_SIZE);
+      }
+      buffered_frame_length = WebRtc_available_read(drr_buffer_) / DRR_FRAME_SIZE;
+    }
+  }
+
+  if (drr_results_index_ == DRR_COMMUNICATION_SLOWDOWN_THRESHOLD) {
+    float sum = 0.0f;
+    for (size_t i = 0; i < DRR_COMMUNICATION_SLOWDOWN_THRESHOLD; ++i) {
+      sum += drr_results_[i];
+    }
+
+    drr_to_emit = sum / DRR_COMMUNICATION_SLOWDOWN_THRESHOLD;
+    drr_results_index_ = 0;
+  }
+
+  return drr_to_emit;
+}
+
+AroundDenoiser::FullPipeline2Result AroundDenoiser::FullPipelineV2(float *analysis_data, size_t analysis_data_len, float rms) {
+  for (size_t i = 0; i < analysis_data_len; ++i) {
+    analysis_data[i] = FloatS16ToFloat(analysis_data[i]) * hanning_window_[i];
+  }
+
+  double filtered[analysis_data_len];
+  lpr(analysis_data, analysis_data_len, filtered);
+
+  double residual_kurtosis = kurtosis(filtered, analysis_data_len);
+
+  if (residual_kurtosis > 0 && prev_kurtosis_ &&
+      (residual_kurtosis - prev_kurtosis_) > settings_.extractors_residual_kurtosis_peak_threshold) {
+    // Prevent some unwanted kurtosis peaks that tend to skew the results
+    residual_kurtosis = prev_kurtosis_;
+  }
+
+  return AroundDenoiser::FullPipeline2Result{ rms, residual_kurtosis };
+}
+
+void AroundDenoiser::ResetDRR() {
+  drr_wema_ = 0.0f;
+  WebRtc_InitBuffer(running_avg_rms_buffer_);
+  WebRtc_InitBuffer(running_avg_res_buffer_);
+}
+
+double AroundDenoiser::FullPipelineV2Normalized(float *analysis_data, size_t analysis_data_len, float rms) {
+  AroundDenoiser::FullPipeline2Result result = FullPipelineV2(analysis_data, analysis_data_len, rms);
+
+  WebRtc_WriteBuffer(running_avg_rms_buffer_, &result.rms, 1);
+  WebRtc_WriteBuffer(running_avg_res_buffer_, &result.residual_kurtosis, 1);
+
+  size_t rms_size = WebRtc_available_read(running_avg_rms_buffer_);
+  size_t res_size = WebRtc_available_read(running_avg_res_buffer_);
+
+  float rms_window[rms_size];
+  double res_window[res_size];
+  WebRtc_ReadBuffer(running_avg_rms_buffer_, NULL, rms_window, rms_size);
+  WebRtc_ReadBuffer(running_avg_res_buffer_, NULL, res_window, res_size);
+
+  WebRtc_MoveReadPtr(running_avg_rms_buffer_,
+    rms_size < settings_.averaging_window ? -rms_size : 1 - rms_size);
+  WebRtc_MoveReadPtr(running_avg_res_buffer_,
+    res_size < settings_.averaging_window ? -res_size : 1 - res_size);
+
+  float rms_sum = 0.0f;
+  for (size_t i = 0; i < rms_size; ++i) {
+    rms_sum += rms_window[i];
+  }
+
+  double res_sum = 0.0f;
+  for (size_t i = 0; i < res_size; ++i) {
+    res_sum += res_window[i];
+  }
+
+  double rms_avg = rms_sum / rms_size;
+  double res_avg = res_sum / res_size;
+  double rms_normalized = normalize(rms_avg, settings_.normalization_rms_low, settings_.normalization_rms_high);
+  double res_normalized = normalize(res_avg, settings_.residual_kurtosis_low, settings_.residual_kurtosis_high);
+
+  // Residual Kurtosis often returns a series of 0-s out of a sudden. Let's try
+  // to ignore these to reduce to saw-tooth effect on the resulting data
+  if (rms_normalized > 0.0) {
+    last_valid_residual_kurtosis_ = rms_normalized;
+    last_valid_residual_kurtosis_distance_ = 0;
+  } else if (last_valid_residual_kurtosis_ > 0.0) {
+    last_valid_residual_kurtosis_distance_++;
+    if (
+      last_valid_residual_kurtosis_distance_ <=
+      kLastValidResidualKurtosisMaxConsideredDistance
+    ) {
+      rms_normalized = last_valid_residual_kurtosis_;
+    } else {
+      last_valid_residual_kurtosis_ = 0.0;
+    }
+  }
+
+  double drr = fmax(0.0, fmin(1.0,
+    res_normalized * settings_.extractors_residual_kurtosis_weight +
+    rms_normalized * settings_.extractors_rms_weight
+  ));
+
+  drr_wema_ = wema_update(
+    drr > drr_wema_ ? settings_.wema_inc_alpha : settings_.wema_dec_alpha,
+    drr_wema_,
+    drr
+  );
+
+  return drr_wema_;
+}
+
+void AroundDenoiser::EncodeFeaturesToSignal(AudioBuffer* audioBuffer) {
+  AudioFrameView<float> frame(audioBuffer->channels_f(),
+                              audioBuffer->num_channels(),
+                              audioBuffer->num_frames());
+  if (frame.num_channels() > 1) {
+    rtc::ArrayView<float> signal = frame.channel(1);
+    signal[0] = audio_features.vad_probability * INT16_MAX;
+    signal[1] = audio_features.rms;
+    // zero out the remaining samples
+    for (size_t sample = 2; sample < signal.size(); sample++) {
+      signal[sample] = 0;
+    }
+  }
+}
+
+void AroundDenoiser::ProcessMutedSpeakingState(float vad, int64_t now) {
+  if (
+    (vad_state_ == MutedStarted) &&
+    (vad_wema_ == 0.0 || vad_wema_ <= VAD_DISABLE_THRESHOLD_PCT) &&
+    muted_vad_disable_timeout_ > 0 &&
+    (now - muted_vad_disable_timeout_ >= VAD_DISABLE_TIMEOUT_MS)
+  ) {
+    vad_state_ = MutedStopped;
+    muted_vad_disable_timeout_ = 0;
+  }
+
+  vad_wema_ = compute_wema(vad_wema_, vad, VAD_MUTED_SMOOTHING_WEMA_ALPHA);
+
+  if (vad_wema_ >= VAD_ENABLED_THRESHOLD_PCT) {
+    vad_state_ = MutedStarted;
+    muted_vad_disable_timeout_ = now;
+  }
+}
+
+void AroundDenoiser::ProcessVADState(float vad, int64_t now) {
+  if (!is_microphone_on_) {
+    ProcessMutedSpeakingState(vad, now);
+    return;
+  }
+
+  if (
+    (vad_state_ == Started || vad_state_ == Sustained) &&
+    (vad == 0.0 || vad <= VAD_DISABLE_THRESHOLD_PCT) &&
+    vad_disable_timeout_ > 0 &&
+    (now - vad_disable_timeout_ >= VAD_DISABLE_TIMEOUT_MS)
+  ) {
+    vad_state_ = Stopped;
+    vad_disable_timeout_ = 0;
+  }
+
+  if (vad >= VAD_ENABLED_THRESHOLD_PCT) {
+    if (vad_state_ == Stopped || vad_state_ == MutedStarted || vad_state_ == MutedStopped) {
+      vad_state_ = Started;
+    }
+    vad_disable_timeout_ = now;
+  }
+
+  vad_wema_ = compute_wema(vad_wema_, vad, VAD_SMOOTHING_WEMA_ALPHA);
+
+  if (
+    vad_state_ == Started &&
+    vad > 0.0 && vad_wema_ > VAD_ENABLED_THRESHOLD_PCT &&
+    vad_state_ != Sustained
+  ) {
+    vad_state_ = Sustained;
+  }
+}
+
+void AroundDenoiser::SetAudioStatus(std::map<std::string, std::string> params) {
+  bool is_microphone_on = params["is_microphone_on"] == "true";
+  bool is_in_group = params["is_in_group"] == "true";
+
+  if (is_microphone_on_ && !is_microphone_on) {
+    vad_wema_ = 0.0;
+  } else if (!is_microphone_on_ && is_microphone_on) {
+    if (vad_state_ == MutedStarted) {
+      vad_state_ = MutedStopped;
+      muted_vad_disable_timeout_ = 0;
+    }
+  }
+
+  is_microphone_on_ = is_microphone_on;
+  is_in_group_ = is_in_group;
+}
+
+void AroundDenoiser::SetDRREnabled(bool enabled) {
+  drr_enabled_ = enabled;
+}
+
+} // namespace webrtc

+    submodules_.around_denoiser->Denoise(capture_buffer, config_.around_audio_processing.noise_suppression_db);
+
+    auto features = submodules_.around_denoiser->getCurrentFeatures();
+
+    // Apply final digital AGC
+    submodules_.around_agc->Process(capture_buffer, features->vad_probability);
+
+    submodules_.around_denoiser->EncodeFeaturesToSignal(capture_buffer);
+
+    float drr_to_emit = submodules_.around_denoiser->ProcessDRREstimation(capture_buffer);
+
+    AroundDenoiser::VADState vad_state = submodules_.around_denoiser->GetCurrentVADState();
+    if (vad_state != previous_vad_state_) {
+      if (vad_state == AroundDenoiser::Stopped) {
+        submodules_.around_denoiser->ResetDRR();
+      }
+
+      DataChannelController* data_channel_controller = DataChannelController::GetSharedDataChannelController();
+      if (data_channel_controller != NULL) {
+        std::string vad_message("vad-stopped");
+        if (vad_state == AroundDenoiser::Started) vad_message = "vad-started";
+        if (vad_state == AroundDenoiser::Sustained) vad_message = "vad-sustained";
+        if (vad_state == AroundDenoiser::MutedStarted) vad_message = "speaking-muted-started";
+        if (vad_state == AroundDenoiser::MutedStopped) vad_message = "speaking-muted-stopped";
+
+        data_channel_controller->SendAroundMessage(vad_message);
+        previous_vad_state_ = vad_state;
+      }
+    }
+
+    if (drr_to_emit != 0.0f) {
+      DataChannelController* data_channel_controller = DataChannelController::GetSharedDataChannelController();
+      if (data_channel_controller != NULL) {
+        std::string drr_state = "drr-data;" + std::to_string(drr_to_emit);
+        data_channel_controller->SendAroundMessage(drr_state);
+      }
+    }
+  }
+
   capture_.was_stream_delay_set = false;
   return kNoError;
 }
 
+void AudioProcessingImpl::InitializeAroundDenoiser() {
+  // Create and initialize only if enabled and the Around NS doesn't already exist.
+  if (!submodules_.around_denoiser) {
+    submodules_.around_denoiser.reset(new AroundDenoiser());
+    submodules_.around_denoiser->Initialize();
+  }
+}
+
+void AudioProcessingImpl::InitializeAroundMaskCompensation() {
+  if (!submodules_.around_mask_compensation) {
+    submodules_.around_mask_compensation.reset(new AroundBiquad());
+  }
+  submodules_.around_mask_compensation->Initialize(MASK_COMPENSATION_COEFFS);
+}
+
+void AudioProcessingImpl::InitializeAroundAgc() {
+  if (!submodules_.around_agc) {
+    submodules_.around_agc.reset(new AroundAgc());
+  }
+  submodules_.around_agc->Initialize(proc_fullband_sample_rate_hz());
+  submodules_.around_agc->Reset();
+}

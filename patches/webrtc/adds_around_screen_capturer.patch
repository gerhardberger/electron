+
+#include <utility>
+#include <cmath>
+
+#include "modules/desktop_capture/screen_capturer_mac_around.h"
+
+#include "rtc_base/time_utils.h"
+
+namespace webrtc {
+
+namespace {
+
+CFArrayRef CreateWindowListWithExclusion() {
+  int own_pid = getpid();
+
+  CFArrayRef all_windows =
+      CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly, kCGNullWindowID);
+  if (!all_windows) return nullptr;
+
+  CFMutableArrayRef returned_array =
+      CFArrayCreateMutable(nullptr, CFArrayGetCount(all_windows), nullptr);
+
+  for (CFIndex i = 0; i < CFArrayGetCount(all_windows); ++i) {
+    CFDictionaryRef window =
+        reinterpret_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(all_windows, i));
+
+    CGWindowID window_id = GetWindowId(window);
+
+    CFNumberRef pid_ref = static_cast<CFNumberRef>(CFDictionaryGetValue(window,
+      kCGWindowOwnerPID));
+    int pid;
+    if (!CFNumberGetValue(pid_ref, kCFNumberIntType, &pid)) continue;
+
+    if (pid != own_pid) {
+      CFArrayAppendValue(returned_array, reinterpret_cast<void*>(window_id));
+    }
+  }
+  CFRelease(all_windows);
+
+  return returned_array;
+}
+
+}
+
+ScreenCapturerMacAround::ScreenCapturerMacAround(
+    rtc::scoped_refptr<DesktopConfigurationMonitor> desktop_config_monitor)
+    : desktop_config_monitor_(std::move(desktop_config_monitor)) {}
+
+ScreenCapturerMacAround::~ScreenCapturerMacAround() {
+  CFRelease(window_list_);
+}
+
+bool ScreenCapturerMacAround::Init() {
+  desktop_config_ = desktop_config_monitor_->desktop_configuration();
+  return true;
+}
+
+bool ScreenCapturerMacAround::GetSourceList(SourceList* screens) {
+  RTC_DCHECK(screens->size() == 0);
+
+  for (MacDisplayConfigurations::iterator it = desktop_config_.displays.begin();
+       it != desktop_config_.displays.end();
+       ++it) {
+    screens->push_back({it->id, std::string()});
+  }
+  return true;
+}
+
+bool ScreenCapturerMacAround::SelectSource(SourceId id) {
+  if (id == kFullDesktopScreenId) {
+    current_display_ = 0;
+  } else {
+    const MacDisplayConfiguration* config =
+        desktop_config_.FindDisplayConfigurationById(static_cast<CGDirectDisplayID>(id));
+    if (!config) return false;
+    current_display_ = config->id;
+  }
+
+  current_screen_bounds_ = GetDisplayBounds(current_display_);
+
+  return true;
+}
+
+void ScreenCapturerMacAround::Start(Callback* callback) {
+  RTC_DCHECK(!callback_);
+  RTC_DCHECK(callback);
+  callback_ = callback;
+
+  window_list_ = CreateWindowListWithExclusion();
+  last_window_list_collection_ = rtc::SystemTimeMillis();
+}
+
+void ScreenCapturerMacAround::CaptureFrame() {
+  TRACE_EVENT0("webrtc", "ScreenCapturerMacAround::CaptureFrame");
+
+  float delta = 1000.0f;
+  bool should_collect_window_list = rtc::TimeSince(last_window_list_collection_) > delta;
+
+  if (should_collect_window_list) {
+    CFRelease(window_list_);
+    window_list_ = CreateWindowListWithExclusion();
+    last_window_list_collection_ = rtc::SystemTimeMillis();
+    current_screen_bounds_ = GetDisplayBounds(current_display_);
+  }
+
+  std::unique_ptr<DesktopFrame> frame = DesktopFrameCGImage::CreateForWindowList(window_list_, current_screen_bounds_);
+  if (!frame) {
+    RTC_LOG(LS_WARNING) << "Temporarily failed to capture window.";
+    callback_->OnCaptureResult(Result::ERROR_TEMPORARY, nullptr);
+    return;
+  }
+
+  DesktopRect bounds = DesktopRect::MakeXYWH(current_screen_bounds_.origin.x, current_screen_bounds_.origin.y,
+    current_screen_bounds_.size.width,
+    current_screen_bounds_.size.height);
+
+  float scale_factor = 1.0f;
+
+  if (!bounds.is_empty() && !frame->size().is_empty()) {
+    float scale_x = frame->size().width() / bounds.width();
+    float scale_y = frame->size().height() / bounds.height();
+    // Currently the scale in X and Y directions must be same.
+    if ((std::fabs(scale_x - scale_y) <=
+         std::numeric_limits<float>::epsilon() * std::max(scale_x, scale_y)) &&
+        scale_x > 0.0f) {
+      scale_factor = scale_x;
+    }
+  }
+
+  frame->mutable_updated_region()->SetRect(
+      DesktopRect::MakeSize(frame->size()));
+  frame->set_top_left(bounds.top_left());
+  frame->set_dpi(DesktopVector(kStandardDPI * scale_factor, kStandardDPI * scale_factor));
+
+  callback_->OnCaptureResult(Result::SUCCESS, std::move(frame));
+}
+
+CGRect ScreenCapturerMacAround::GetDisplayBounds(CGDirectDisplayID current_display) {
+  const MacDisplayConfiguration* config =
+    desktop_config_.FindDisplayConfigurationById(current_display);
+  if (!config) return NSZeroRect;
+  DesktopRect display_bounds = config->bounds;
+
+  return NSMakeRect(display_bounds.left(),
+    display_bounds.top(), display_bounds.width(), display_bounds.height());
+}
+
+}  // namespace webrtc

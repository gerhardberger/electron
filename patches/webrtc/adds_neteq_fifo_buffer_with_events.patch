+uint64_t PacketBuffer::GetAbsCaptureTimeDiff() const {
+  if (buffer_.size() == 0) {
+    return 0;
+  }
+  int64_t end = buffer_.back().packet_info.get_absolute_capture_time_ms();
+  int64_t start = buffer_.front().packet_info.get_absolute_capture_time_ms();
+  return end > start ? end - start : 0;
+
+}

   } else if (auto* configure = xev.As<x11::ConfigureNotifyEvent>()) {
@@ -2251,6 +2272,13 @@ void X11Window::DelayedResize(const gfx::Rect& bounds_in_pixels) {
                    ++current_counter_value_);
   }
 
+  if (is_mouse_button_down_) {
+    if (!is_resizing_) {
+      OnXWindowWillResize(bounds_in_pixels);
+    }
+    is_resizing_ = true;
+  }
+
   CancelResize();
   NotifyBoundsChanged(bounds_in_pixels);
 

+#if defined(OS_LINUX)
+void Widget::OnNativeWidgetWillResize(const gfx::Size& new_size) {
+  View* root = GetRootView();
+  if (root)
+    root->SetSize(new_size);
+
+  NotifyCaretBoundsChanged(GetInputMethod());
+  SaveWindowPlacementIfInitialized();
+
+  for (WidgetObserver& observer : observers_)
+    observer.OnWidgetWillResize(this, GetWindowBoundsInScreen());
+}
+
+void Widget::OnNativeWidgetDidResize() {
+  for (WidgetObserver& observer : observers_)
+    observer.OnWidgetDidResize(this);
+}

+#if defined(OS_LINUX)
+void DesktopNativeWidgetAura::OnHostWillResize(aura::WindowTreeHost* host) {
+  if (desktop_window_tree_host_->IsAnimatingClosed())
+    return;
+
+  gfx::Rect new_bounds = gfx::Rect(host->window()->bounds().size());
+  content_window_->SetBounds(new_bounds);
+  native_widget_delegate_->OnNativeWidgetWillResize(new_bounds.size());
+}
+
+void DesktopNativeWidgetAura::OnHostDidResize(aura::WindowTreeHost* host) {
+  native_widget_delegate_->OnNativeWidgetDidResize();
+}
+#endif

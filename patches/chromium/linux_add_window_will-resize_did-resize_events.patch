@@ -2040,6 +2048,19 @@ void X11Window::HandleEvent(const x11::Event& xev) {
                                     expose->height);
     OnXWindowDamageEvent(damage_rect_in_pixels);
   } else if (auto* focus = xev.As<x11::FocusEvent>()) {
+    if (focus->mode == x11::NotifyMode::Grab) {
+      is_mouse_button_down_ = true;
+    }
+
+    if (focus->mode == x11::NotifyMode::Ungrab) {
+      is_mouse_button_down_ = false;
+
+      if (is_resizing_) {
+        is_resizing_ = false;
+        OnXWindowDidResize();
+      }
+    }
+
     OnFocusEvent(focus->opcode == x11::FocusEvent::In, focus->mode,
                  focus->detail);
   } else if (auto* configure = xev.As<x11::ConfigureNotifyEvent>()) {
@@ -2270,6 +2291,13 @@ void X11Window::DelayedResize(const gfx::Rect& bounds_in_pixels) {
                    ++current_counter_value_);
   }
 
+  if (is_mouse_button_down_) {
+    if (!is_resizing_) {
+      OnXWindowWillResize(bounds_in_pixels);
+    }
+    is_resizing_ = true;
+  }
+
   CancelResize();
   NotifyBoundsChanged(bounds_in_pixels);
 

     OnXWindowDamageEvent(damage_rect_in_pixels);
   } else if (auto* focus = xev.As<x11::FocusEvent>()) {
+    if (focus->mode == x11::NotifyMode::Grab) {
+      is_mouse_button_down_ = true;
+    }
+
+    if (focus->mode == x11::NotifyMode::Ungrab) {
+      is_mouse_button_down_ = false;
+
+      if (is_resizing_) {
+        is_resizing_ = false;
+        OnXWindowDidResize();
+      }
+    }

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gellert <gellert.hegyi@around.co>
Date: Fri, 13 Aug 2021 11:42:52 +0200
Subject: linux add window will-resize did-resize events

This patch adds similar window did-resize and will-resize events to linux as there is for macOS and Windows.

diff --git a/ui/aura/window_tree_host.cc b/ui/aura/window_tree_host.cc
index 35e0e635d1f167e05eac2734f4d93b665facc67b..df9d9b17f8e4e24634dd431c7789a67e7c2d70d6 100644
--- a/ui/aura/window_tree_host.cc
+++ b/ui/aura/window_tree_host.cc
@@ -471,6 +471,24 @@ void WindowTreeHost::OnHostMovedInPixels(
     observer.OnHostMovedInPixels(this, new_location_in_pixels);
 }
 
+void WindowTreeHost::OnHostWillResize(const gfx::Size& new_size_in_pixels) {
+  if (!compositor_)
+    return;
+  display::Display display =
+      display::Screen::GetScreen()->GetDisplayNearestWindow(window());
+  device_scale_factor_ = display.device_scale_factor();
+  UpdateRootWindowSizeInPixels();
+  UpdateCompositorScaleAndSize(new_size_in_pixels);
+
+  for (WindowTreeHostObserver& observer : observers_)
+    observer.OnHostWillResize(this);
+}
+
+void WindowTreeHost::OnHostDidResize() {
+  for (WindowTreeHostObserver& observer : observers_)
+    observer.OnHostDidResize(this);
+}
+

+
   std::unique_ptr<media::VideoCaptureDevice> video_capture_device;
 #if defined(OS_ANDROID)
   video_capture_device = std::make_unique<ScreenCaptureDeviceAndroid>();
 #else
 #if defined(OS_MAC)
-  if (base::FeatureList::IsEnabled(kDesktopCaptureMacV2))

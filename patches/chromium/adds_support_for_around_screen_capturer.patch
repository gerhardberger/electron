   if (!video_capture_device)
-    video_capture_device = DesktopCaptureDevice::Create(desktop_id);
+    video_capture_device = DesktopCaptureDevice::Create(desktop_id, using_around_capturer);
 #endif
 
   if (video_capture_device)

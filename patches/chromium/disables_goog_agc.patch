From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gellert <gellert.hegyi@around.co>
Date: Sat, 16 May 2020 00:11:23 +0200
Subject: disables goog agc

Disables experimental AGC1 mode in MediaStreamAudioProcessor.

Signed-off-by: gellert <gellert.hegyi@around.co>

diff --git a/third_party/blink/renderer/platform/mediastream/media_stream_audio_processor_options.cc b/third_party/blink/renderer/platform/mediastream/media_stream_audio_processor_options.cc
index 46902069ce04dd42b28e259d75282de9c4ed23be..0f4a02f155d3318f8e0d74c33d2b584e826f3c91 100644
--- a/third_party/blink/renderer/platform/mediastream/media_stream_audio_processor_options.cc
+++ b/third_party/blink/renderer/platform/mediastream/media_stream_audio_processor_options.cc
@@ -442,7 +442,9 @@ rtc::scoped_refptr<webrtc::AudioProcessing> CreateWebRtcAudioProcessingModule(
     experimental_agc->digital_adaptive_disabled =
         hybrid_agc_params.has_value() && !hybrid_agc_params->dry_run;
     config.Set<webrtc::ExperimentalAgc>(experimental_agc);
-#if BUILDFLAG(IS_CHROMECAST)
+// @AROUND we want the Experimental AGC option to always be turned off if
+// it's disabled in the APM properties (media_stream_audio_processor_options.cc)
+// #if defined(IS_CHROMECAST)
   } else {
     // Do not use the analog controller.
     // This should likely be done on non-Chromecast platforms as well, but care
@@ -450,7 +452,7 @@ rtc::scoped_refptr<webrtc::AudioProcessing> CreateWebRtcAudioProcessingModule(
     // https://crbug.com/918677#c4
     config.Set<webrtc::ExperimentalAgc>(
         new webrtc::ExperimentalAgc(/*enabled=*/false));
-#endif  // BUILDFLAG(IS_CHROMECAST)
+// #endif  // BUILDFLAG(IS_CHROMECAST)
   }
 
   // Create and configure the webrtc::AudioProcessing.

+                    brightness, brightness, brightness, 1);
+  }
+
+  float4x4 contrastMatrix(float contrast) {
+    float t = (1.0 - contrast) / 2.0;
+    return float4x4(contrast, 0, 0, 0,
+                    0, contrast, 0, 0,
+                    0, 0, contrast, 0,
+                    t, t, t, 1);
+  }
+
+  float4x4 saturationMatrix(float saturation) {
+      float saturationFlipped = 1.0 - saturation;
+      float3 saturationX = float3(luminance.x * saturationFlipped);
+      float3 saturationY = float3(luminance.y * saturationFlipped);
+      float3 saturationZ = float3(luminance.z * saturationFlipped);
+      saturationX += float3( saturation, 0, 0 );
+      saturationY += float3( 0, saturation, 0 );
+      saturationZ += float3( 0, 0, saturation );
+
+      return float4x4(saturationX, 0,
+                      saturationY, 0,
+                      saturationZ, 0,
+                          0, 0, 0, 1);
+  }
+
+  float diag(float a, float b) {
+    return sqrt((a + b) * (a + b)) / 2.5;
+  }
+
+  float4 gradient2Colors(float4 a, float4 b, float w) {
+    return float4(mix(a.r, b.r, w), mix(a.g, b.g, w), mix(a.b, b.b, w), mix(a.a, b.a, w));
+  }
+
+  float softlight(float srcc, float srca, float dstc,
+                              float dsta) {
+    if (2.0 * srcc <= srca) {
+      return (dstc * dstc * (srca - 2.0 * srcc)) / dsta +
+              (1.0 - dsta) * srcc + dstc * (-srca + 2.0 * srcc + 1.0);
+    } else if (4.0 * dstc <= dsta) {
+      float DSqd = dstc * dstc;
+      float DCub = DSqd * dstc;
+      float DaSqd = dsta * dsta;
+      float DaCub = DaSqd * dsta;
+      return (-DaCub * srcc +
+              DaSqd * (srcc - dstc * (3.0 * srca - 6.0 * srcc - 1.0)) +
+              12.0 * dsta * DSqd * (srca - 2.0 * srcc) -
+              16.0 * DCub * (srca - 2.0 * srcc)) /
+              DaSqd;
+    } else {
+      return -sqrt(dsta * dstc) * (srca - 2.0 * srcc) - dsta * srcc +
+              dstc * (srca - 2.0 * srcc + 1.0) + srcc;
+    }
+  }
+
+  float tri(in float x) {
+    float h = fract(x*.5)-.5;
+    return 1.-2.*abs(h);
+  }
+
+  half4 main(float2 coord) {
+    float2 uv = float2(coord.x + 0.5, coord.y + 0.5);
+    coord = float2(uv.x * width, uv.y * height);
+    float2 offset = float2(offset_x, offset_y);
+    float2 scale = float2(zoom, zoom);
+    float2 new_coord = coord * scale + offset;
+    half4 texelColor = sample(input, new_coord);
+
+    float contrast = 1.0;
+    float brightness = 0.0;
+
+    half4 grey = half4(dot(texelColor.rgb, float3(0.52, 0.587, 0.114)));
+    float diagonalTopRight = diag(uv.x, uv.y);
+    float cubic = smoothstep(0.0, 1.0, clamp(0.0, 1.0, diagonalTopRight));
+
+    vec4 base = brightnessMatrix(brightness) * contrastMatrix(contrast) * grey;
+    half4 filter = texelColor;
+
+    if (filter_id == 1) {
+      filter = base;
+    } else if (filter_id == 2) {
+      float4 gradient = gradient2Colors(color_bluepurple, float4(1.0, 1.0, 1.0, 0.0), cubic);
+      filter = base * gradient;
+    } else if (filter_id == 3) { // hacker mode
+      filter = mix(color_darkpurple, color_green, base);
+    } else if (filter_id == 4) { // purple/blue LEDs
+      filter = float4(base.r * uv.x, base.g * uv.y, base.b, 1.0);
+    } else if (filter_id == 5) { // yellow magenta
+      filter = mix(color_purple, color_yellow, base);
+    } else if (filter_id == 6) { // purple duo
+      filter = mix(color_darkpurple, color_magenta, base);
+    } else if (filter_id == 7) { // enhanced brightness/constrast
+      filter = brightnessMatrix(brightness) * contrastMatrix(contrast) * saturationMatrix(0.85) * texelColor;
+    } else if (filter_id == 8) { // red green
+      filter = float4(base.r * (1.2 - uv.x), base.g * (uv.y), base.b * uv.y * 0.7 + 0.25 , 1.0);
+    } else if (filter_id == 9) { // pink sunset
+      base = brightnessMatrix(brightness) * contrastMatrix(contrast) * texelColor;
+      filter = gradient2Colors(float4(base.r, base.g * uv.y * 0.1, base.b * 0.2, 1.0) * (1.0 - uv.y), mix(float4(base.r, base.g * uv.y, base.b * 0.1, 1.0), float4(1,1,0,1), base), uv.y);
+    } else if (filter_id == 10) { // magenta green
+      filter = mix(float4(0.0, 0.0, 0.0, 1.0), gradient2Colors(float4(1.0,1.0,0.0,1.0), color_coldblue, uv.x), base);
+    } else if (filter_id == 11) { // colorful mix
+      filter = float4(base.r * (1.2 - uv.y), base.g * (uv.x), base.b * uv.y * 0.8 + 0.2, 1.0);
+    } else if (filter_id == 12) { // gameboy
+      base = float4(levels(grey.rgb, 55.0/255.0, 1.3, 235.0/255.0), 1.0);
+      float4 dithered = float4(dither4x4(coord * (1.0) * 2.0, base.r));
+      filter = mix(color_darkblue, color_displaygreen, dithered);
+    } else if (filter_id == 13) { // pink pixels
+      base = float4(levels(grey.rgb, 55.0/255.0, 1.3, 235.0/255.0), 1.0);
+      float4 dithered = float4(dither4x4(coord * (1.0) * 2.0, base.r));
+      filter = mix(color_purple1990, color_pinkhotel, dithered);
+    } else if (filter_id == 14) { // sunrise
+      // colors
+      half4 top = half4(50.0, 197.0, 255.0, 255.0) / 255.0;
+      half4 bot = half4(182.0, 32.0, 224.0, 255.0) / 255.0;
+
+      // gradient
+      half4 grad = mix(top, bot, uv.y);
+
+      // soft light
+      float r = softlight(grad.r, grad.a, texelColor.r, 1.0);
+      float g = softlight(grad.g, grad.a, texelColor.g, 1.0);
+      float b = softlight(grad.b, grad.a, texelColor.b, 1.0);
+
+      filter = half4(r, g, b, 1.0);
+    } else if (filter_id == 15) { // sunset
+      // colors
+      half4 tl = half4(253.0, 194.0, 42.0, 255.0) / 255.0;
+      half4 tr = half4(255.0, 61.0, 0.0, 255.0) / 255.0;
+      half4 bl = half4(214.0, 125.0, 255.0, 255.0) / 255.0;
+      half4 br = half4(214.0, 125.0, 255.0, 255.0) / 255.0;
+
+      // gradient
+      half4 tgrad = mix(tl, tr, uv.x);
+      half4 bgrad = mix(bl, br, uv.x);
+      half4 grad = mix(tgrad, bgrad, uv.y);
+
+      // soft light
+      float r = softlight(grad.r, grad.a, texelColor.r, 1.0);
+      float g = softlight(grad.g, grad.a, texelColor.g, 1.0);
+      float b = softlight(grad.b, grad.a, texelColor.b, 1.0);
+
+      filter = vec4(r, g, b, 1.0);
+    }
+
+    return half4(filter.r, filter.g, filter.b, 1.0);
+  }
+)";

@@ -979,6 +982,16 @@ bool DirectRenderer::ShouldApplyRoundedCorner(const DrawQuad* quad) const {
   if (!mask_filter_info.HasRoundedCorners())
     return false;
 
+  // AROUND: filters and bounding box shader is applied as a Skia ImageFilter,
+  // which operates in a weird coordinate space that is not in line with how the
+  // DirectRenderer treats rounded corners. In order to cut a perfect circle, we
+  // transform the target quad according to the ImageFilter, but in some
+  // scenarios this can cause computed rounded corners to not intersect with it
+  // (the code below). So if we apply ImageFilter, we always want to clip.
+  if (sqs->filter_id > 0 || !sqs->bounding_box.IsEmpty()) {
+    return true;
+  }
+
   const gfx::RRectF& rounded_corner_bounds =
       mask_filter_info.rounded_corner_bounds();
 

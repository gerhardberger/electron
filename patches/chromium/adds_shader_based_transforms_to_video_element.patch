+void SoftwareRenderer::SetAroundFilter(SkPaint& paint, const SkImage* image, int filter_id, gfx::RectF bounding_box, gfx::RectF rect) {
+  if (filter_id == 0 && bounding_box.IsEmpty()) {
+    return;
+  }
+
+  if (!around_shader_cache_) {
+    around_shader_cache_ = SkRuntimeEffect::MakeForShader(SkString(kAroundShader)).effect;
+  }
+
+  AroundShaderInput uniforms;
+  uniforms.filter_id = filter_id;
+  uniforms.offset_x = bounding_box.x() * image->width();
+  uniforms.offset_y = bounding_box.y() * image->height();
+  uniforms.zoom = fmax(
+    bounding_box.width() * (image->width() / rect.width()),
+    bounding_box.height() * (image->height() / rect.height()));
+  uniforms.width = rect.width();
+  uniforms.height = rect.height();
+
+  sk_sp<SkData> data = SkData::MakeWithCopy(&uniforms, sizeof(uniforms));
+  sk_sp<SkShader> imageShader = image->makeShader(SkSamplingOptions(SkFilterMode::kLinear));
+  sk_sp<SkShader> children[] = { imageShader };
+  sk_sp<SkShader> myShader = around_shader_cache_->makeShader(
+    /*uniforms=*/    std::move(data),
+    /*children=*/    children,
+    /*childCount=*/  1,
+    /*localMatrix=*/ nullptr,
+    /*isOpaque=*/    false);
+
+  sk_sp<SkImageFilter> image_filter = SkImageFilters::Shader(std::move(myShader));
+  paint.setImageFilter(image_filter);
+}

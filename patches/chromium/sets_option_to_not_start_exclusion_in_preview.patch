Date: Tue, 30 Jun 2020 18:56:09 +0200
Subject: sets option to not start exclusion in preview

This patch sets a flag that will prevent window exclusion while in preview when doing screensharing

Signed-off-by: gellert <gellert.hegyi@around.co>

diff --git a/content/browser/media/capture/desktop_capture_device.cc b/content/browser/media/capture/desktop_capture_device.cc
index cdbac5d5e7c9734fa4a18f82e0c37cbc52c813de..48a40231a248327b8adc4a207fbe3f767ba2b6c6 100644
--- a/content/browser/media/capture/desktop_capture_device.cc
+++ b/content/browser/media/capture/desktop_capture_device.cc
@@ -264,6 +264,7 @@ void DesktopCaptureDevice::Core::AllocateAndStart(
   DCHECK(!wake_lock_);
   RequestWakeLock();
 
+  desktop_capturer_->should_exclude_ = true;
   desktop_capturer_->Start(this);
   // Assume it will be always started successfully for now.
   client_->OnStarted();

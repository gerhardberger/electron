   if (event->IsMouseEvent() &&
       HandleMouseEventWithHitTest(hit_test, event->AsMouseEvent())) {
@@ -52,6 +47,15 @@ void WindowEventFilterLinux::HandleLocatedEventWithHitTest(
 bool WindowEventFilterLinux::HandleMouseEventWithHitTest(
     int hit_test,
     ui::MouseEvent* event) {
+#if defined(OS_LINUX)
+  if (hit_test == HTDRAG && previous_event_type_ == ui::ET_MOUSE_PRESSED && event->type() == ui::ET_MOUSE_DRAGGED) {

@@ -12,7 +12,6 @@
 #include "ui/base/hit_test.h"
 #include "ui/display/display.h"
 #include "ui/display/screen.h"
-#include "ui/events/event.h"
 #include "ui/events/event_utils.h"
 #include "ui/platform_window/wm/wm_move_resize_handler.h"

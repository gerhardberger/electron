@@ -32,10 +31,6 @@ WindowEventFilterLinux::~WindowEventFilterLinux() = default;
 void WindowEventFilterLinux::HandleLocatedEventWithHitTest(
     int hit_test,
     ui::LocatedEvent* event) {
-  if (event->type() != ui::ET_MOUSE_PRESSED &&

       w_param != HTCAPTION &&
       delegate_->GetFrameMode() == FrameMode::CUSTOM_DRAWN) {
@@ -3172,12 +3181,6 @@ LRESULT HWNDMessageHandler::HandleMouseEventInternal(UINT message,

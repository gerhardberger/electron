   for (MediaStreamTrack* track : track_vector) {
@@ -289,6 +310,24 @@ void MediaStream::addTrack(MediaStreamTrack* track,
 
   switch (track->Component()->Source()->GetType()) {
     case MediaStreamSource::kTypeAudio:
+      if (track->label() == kGroupOutputLabel) {
+        PeerConnectionDependencyFactory::From(*GetExecutionContext()).GetWebRtcAudioDevice()->
+          SetAroundPrimaryPlayoutSink(MediaStreamAudioSource::From(track->Component()->Source()), kLocalPlaybackDelay);
+      } else if (track->label() == kGroupInputLabel) {
+        // Init the mixer and connect destination track.

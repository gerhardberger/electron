index 0000000000000000000000000000000000000000..9dcd56ecf9944cbd34acc56654410ab0c4bc0c49
--- /dev/null
+++ b/third_party/blink/renderer/modules/mediastream/around_audio_mixer.cc
@@ -0,0 +1,243 @@
+#include "third_party/blink/renderer/modules/mediastream/around_audio_mixer.h"
+
+#include "base/logging.h"
+#include "rtc_base/checks.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/modules/peerconnection/peer_connection_dependency_factory.h"
+#include "third_party/blink/renderer/modules/webrtc/webrtc_audio_device_impl.h"
+#include "third_party/blink/renderer/platform/mediastream/media_stream_audio_source.h"
+#include "third_party/webrtc/audio/audio_receive_stream.h"
+#include "third_party/webrtc/audio/utility/audio_frame_operations.h"
+#include "third_party/webrtc/modules/audio_mixer/audio_mixer_impl.h"
+#include "third_party/blink/renderer/platform/scheduler/public/thread.h"
+
+namespace blink {
+
+namespace {
+// This is a special value used by PeerManager for receive streams between primary and
+// secondaries in ET group. It has to match what is defined as FIFO_BUFFER_INDICATOR in peerManager.ts
+const int kFifoBufferIndicator = 79;
+}
+
+AroundAudioMixer::AroundAudioMixer() {
+  playback_mixer_ = webrtc::AudioMixerImpl::Create();
+}
+
+bool AroundAudioMixer::AddSource(webrtc::AudioMixer::Source* audio_source) {
+  webrtc::MutexLock lock(&mutex_);
+  auto* receive_stream = static_cast<webrtc::internal::AudioReceiveStream*>(audio_source);
+  if (receive_stream->config().jitter_buffer_max_packets == kFifoBufferIndicator) {
+    if (microphone_mixer_) {
+      return microphone_mixer_->AddSource(audio_source);
+    }
+  }
+  return playback_mixer_->AddSource(audio_source);
+}
+
+void AroundAudioMixer::RemoveSource(webrtc::AudioMixer::Source* audio_source) {
+  webrtc::MutexLock lock(&mutex_);
+  auto* receive_stream = static_cast<webrtc::internal::AudioReceiveStream*>(audio_source);
+  if (receive_stream->config().jitter_buffer_max_packets == kFifoBufferIndicator) {
+    if (microphone_mixer_) {
+      // When a secondary becomes the primary then it can happen that microphone_mixer gets
+      // created before secondary's stream is cleaned up.
+      auto sources = microphone_mixer_->audio_sources();
+      if (std::find(sources.begin(), sources.end(), audio_source) != sources.end()) {
+        microphone_mixer_->RemoveSource(audio_source);
+        return;
+      }
+    }
+  }
+  auto sources = playback_mixer_->audio_sources();
+  // There are cases where microphone_mixer teardown happens before calls to RemoveSource().
+  // Attempt to remove non existing source causes crash.
+  if (std::find(sources.begin(), sources.end(), audio_source) != sources.end()) {
+    playback_mixer_->RemoveSource(audio_source);
+    return;
+  }
+}
+
+void AroundAudioMixer::Mix(size_t number_of_channels,
+         webrtc::AudioFrame* audio_frame_for_mixing) {
+  playback_mixer_->Mix(number_of_channels, audio_frame_for_mixing);
+}
+
+std::vector<webrtc::AudioMixer::Source*> AroundAudioMixer::audio_sources() {
+  // This is supposedly used only on secondaries to detect fifo buffer underruns and mute mic to prevent echo.
+  // On secondaries only playback_mixer is relevant.
+  return playback_mixer_->audio_sources();
+}
+
+void AroundAudioMixer::OnData(const media::AudioBus& audio_bus,
+            base::TimeTicks estimated_capture_time) {
+  webrtc::MutexLock lock(&mutex_);
+  if (!destination_)
+    return;
+
+  DCHECK_EQ(audio_bus.frames(), 480);
+  for (int i = 0; i < 480; i++) {
+    delay_buffer_[delay_index_ * 480 + i] = media::SignedInt16SampleTypeTraits::FromFloat(audio_bus.channel(0)[i]);
+  }
+  delay_index_++;
+  if (delay_index_ > delay_) {
+    delay_index_ = 0;
+  }
+  if (debug_sync_mode_) {
+    DeliverMicrophoneInputsToDestination();
+  } else {
+    MixMicrophoneInputsAndDeliverToDestination();
+  }
+}
+
+void AroundAudioMixer::OnSetFormat(const media::AudioParameters& params) {
+}
+
+void AroundAudioMixer::OnReadyStateChanged(WebMediaStreamSource::ReadyState state) {
+}
+
+webrtc::AudioMixer::Source::AudioFrameInfo
+  AroundAudioMixer::GetAudioFrameWithInfo(int sample_rate_hz,
+                                          webrtc::AudioFrame* audio_frame) {
+  audio_frame->UpdateFrame(0,
+                           &delay_buffer_[delay_index_ * 480],
+                           480,
+                           48000,
+                           webrtc::AudioFrame::kNormalSpeech,
+                           webrtc::AudioFrame::kVadUnknown);
+  return webrtc::AudioMixer::Source::AudioFrameInfo::kNormal;
+}
+
+int AroundAudioMixer::Ssrc() const {
+  return 1;       // Just some number for local microphone, which hopefully doesn't clash.
+}
+
+int AroundAudioMixer::PreferredSampleRate() const {
+  return 48000;
+}
+
+void AroundAudioMixer::OnPlayoutData(media::AudioBus* audio_bus,
+                   int sample_rate,
+                   base::TimeDelta audio_delay) {
+  MixMicrophoneInputsAndDeliverToDestination();
+}
+
+void AroundAudioMixer::OnPlayoutDataSourceChanged() {
+}
+
+void AroundAudioMixer::OnRenderThreadChanged() {
+}
+// |audio_device| - nullptr to set debug sync mode
+void AroundAudioMixer::ConnectDestination(MediaStreamAudioSource* destination,
+                                          WebRtcAudioDeviceImpl* audio_device) {
+  webrtc::MutexLock lock(&mutex_);
+  destination_ = destination;
+  if (destination_) {
+    have_set_destination_format_ = false;
+    if (audio_device) {
+      debug_sync_mode_ = false;
+      playback_device_ = audio_device;
+      microphone_mixer_ = webrtc::AudioMixerImpl::Create();
+      MayMoveSecondarySourcesToMicMixer();
+      audio_bus_ = media::AudioBus::Create(1, 480);
+      DriveWithPlayback(true);
+    } else {
+      debug_sync_mode_ = true;
+      audio_bus_ = media::AudioBus::Create(2, 480);
+    }
+  } else {
+    DriveWithPlayback(false);
+    microphone_mixer_ = nullptr;
+    audio_bus_ = nullptr;
+    debug_sync_mode_ = false;
+  }
+}
+
+void AroundAudioMixer::ConnectLocalMicrophone(const WebMediaStreamTrack& track, int delay) {
+  webrtc::MutexLock lock(&mutex_);
+  DriveWithPlayback(false);
+  delay_ = delay;
+  delay_index_ = 0;
+  delay_buffer_.resize((delay_ + 1) * 480);
+  microphone_mixer_->AddSource(this);
+  WebMediaStreamAudioSink::AddToAudioTrack(this, track);
+}
+
+void AroundAudioMixer::DisconnectLocalMicrophone(const WebMediaStreamTrack& track) {
+  webrtc::MutexLock lock(&mutex_);
+  microphone_mixer_->RemoveSource(this);
+  delay_buffer_.clear();
+  WebMediaStreamAudioSink::RemoveFromAudioTrack(this, track);
+  DriveWithPlayback(true);
+}
+
+void AroundAudioMixer::DriveWithPlayback(bool value) {
+  if (value) {
+    playback_device_->AddPlayoutSink(this);
+  } else {
+    playback_device_->RemovePlayoutSink(this);
+  }
+}
+
+void AroundAudioMixer::MixMicrophoneInputsAndDeliverToDestination() {
+  microphone_mixer_->Mix(1, &mixed_frame_);
+  DeliverToDestination();
+}
+
+void AroundAudioMixer::DeliverToDestination() {
+  if (!have_set_destination_format_) {
+    destination_->SetFormat(
+        media::AudioParameters(media::AudioParameters::AUDIO_PCM_LOW_LATENCY,
+                               media::GuessChannelLayout(audio_bus_->channels()),
+                               audio_bus_->frames() * 100, audio_bus_->frames()));
+    have_set_destination_format_ = true;
+  }
+  audio_bus_->FromInterleaved<media::SignedInt16SampleTypeTraits>(
+    mixed_frame_.data(), 480);
+  destination_->DeliverDataToTracks(*audio_bus_, base::TimeTicks::Now());
+}
+
+void AroundAudioMixer::DeliverMicrophoneInputsToDestination() {
+  // todo::audio_sources() can block! Cache it or maybe it is ok for debug code path.
+  auto audio_sources = microphone_mixer_->audio_sources();
+  if (audio_sources.size() < 2 ) {
+    webrtc::AudioFrameOperations::Mute(&mixed_frame_);
+    DeliverToDestination();
+    return;
+  }
+  webrtc::AudioFrame channels[2];
+  audio_sources[0]->GetAudioFrameWithInfo(
+            48000, &channels[0]);
+  audio_sources[1]->GetAudioFrameWithInfo(
+            48000, &channels[1]);
+  int16_t* frame_data = mixed_frame_.mutable_data();
+  for (int i = 0; i < 480; i++) {
+      frame_data[2 * i] = channels[0].mutable_data()[i];
+      frame_data[2 * i + 1] = channels[1].mutable_data()[i];
+  }
+  mixed_frame_.num_channels_ = 2;
+  DeliverToDestination();
+}
+
+void AroundAudioMixer::MayMoveSecondarySourcesToMicMixer() {
+  // At the time of mic mixer creation, some secondary mic sources may have been added to
+  // playback mixer. Move these to the proper mixer.
+  RTC_DCHECK(playback_mixer_);
+  RTC_DCHECK(microphone_mixer_);
+
+  // Note that audio_sources() returns a vector copied from playback_mixer_'s internal
+  // array. Therefore we can modify mixer sources without affecting iteration.
+  bool sources_moved = false;
+  auto sources = playback_mixer_->audio_sources();
+  std::for_each(sources.begin(), sources.end(), [&](auto& x){
+    auto* maybe_receive_stream = static_cast<webrtc::internal::AudioReceiveStream*>(x);
+    if (maybe_receive_stream->config().jitter_buffer_max_packets == kFifoBufferIndicator) {
+      playback_mixer_->RemoveSource(x);
+      microphone_mixer_->AddSource(x);
+      sources_moved = true;
+    }
+  });
+
+  LOG_IF(WARNING, sources_moved) << "Sources have been moved from playback to mic mixer";
+}
+
+}

+// @AROUND: added for native ET mixing.
+const char* kGroupInputLabel = "group_capture";
+const char* kGroupOutputLabel = "group_playback";
+// For debugging microphone sync.
+const char* kDebugGroupInputLabel = "debug_sync";
+
+// Returns certainly known audio latency in local audio pipeline.
+// @return int - latency in 10ms units
+static int getKnownAudioLatency(bool forPlayback) {
+#if defined(OS_MAC)
+  const base::CommandLine* cmd_line = base::CommandLine::ForCurrentProcess();
+  int audio_latency_factor = 0;
+  std::string audio_latency_factor_str(cmd_line->GetSwitchValueASCII(
+      switches::kAudioLatencyFactor));
+  if (base::StringToInt(audio_latency_factor_str, &audio_latency_factor) && audio_latency_factor > 0) {
+    return audio_latency_factor - 1;              // 1 - 10ms, this doesn't add any extra latency yet.
+  }
+#endif
+#if defined(_WIN32)
+  if (forPlayback) {
+    return 4;     //On Windows audio engine typically adds 30-40ms of extra delay.
+  }
+#endif
+  return 0;
+}
+
+static int getLocalCaptureDelayForPrimary() {
+  int latency = 20 - getKnownAudioLatency(false);      // 20 - 200ms base delay.
+  DCHECK(latency >= 0);
+  return latency;
+}
+
+static int getLocalPlaybackDelayForPrimary() {
+  int latency = 20 - getKnownAudioLatency(true);
+  DCHECK(latency >= 0);
+  return latency;
+}
+
 }  // namespace
 

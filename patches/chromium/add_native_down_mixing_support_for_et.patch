       break;
     case MediaStreamSource::kTypeVideo:
@@ -320,8 +359,20 @@ void MediaStream::removeTrack(MediaStreamTrack* track,
   switch (track->Component()->Source()->GetType()) {
     case MediaStreamSource::kTypeAudio:
       pos = audio_tracks_.Find(track);
-      if (pos != kNotFound)
+      if (pos != kNotFound) {
+        if (track->label() == kGroupOutputLabel) {
+          WebRtcAudioDeviceImpl* audio_device = PeerConnectionDependencyFactory::From(*GetExecutionContext()).GetWebRtcAudioDevice();
+          audio_device->SetAroundPrimaryPlayoutSink(nullptr, 0);
+        } else if (track->label() == kGroupInputLabel) {
+          // Teardown the mixer.
+          auto* mixer = static_cast<AroundAudioMixer*>(PeerConnectionDependencyFactory::From(*GetExecutionContext()).GetWebRtcAudioMixer());
+          mixer->ConnectDestination(nullptr, nullptr);
+        } else if (audio_tracks_.size() == 2 && audio_tracks_[0]->label() == kGroupInputLabel) {
+          auto* mixer = static_cast<AroundAudioMixer*>(PeerConnectionDependencyFactory::From(*GetExecutionContext()).GetWebRtcAudioMixer());
+          mixer->DisconnectLocalMicrophone(WebMediaStreamTrack(track->Component()));
+        }
         audio_tracks_.EraseAt(pos);
+      }
       break;
     case MediaStreamSource::kTypeVideo:
       pos = video_tracks_.Find(track);
@@ -356,7 +407,41 @@ MediaStreamTrack* MediaStream::getTrackById(String id) {
     if ((*iter)->id() == id)
       return iter->Get();
   }
-
+  if (id == kGroupOutputLabel || id == kGroupInputLabel) {
+    auto* media_stream_source = MakeGarbageCollected<MediaStreamSource>(
+        id, MediaStreamSource::StreamType::kTypeAudio, id, false /* is_remote */);
+    if (!media_stream_source) {
+      return nullptr;
+    }
+    auto* media_stream_component =
+        MakeGarbageCollected<MediaStreamComponent>(media_stream_source);
+    if (!media_stream_component) {
+      return nullptr;
+    }
+    MediaStreamAudioSource* const media_stream_audio_source =
+        new MediaStreamAudioSource(Thread::MainThread()->GetTaskRunner(), true);
+    if (!media_stream_audio_source) {
+      return nullptr;
+    }
+    // |media_stream_source| takes ownership of |media_stream_audio_source|.
+    media_stream_source->SetPlatformSource(
+        base::WrapUnique(media_stream_audio_source));
+
+    MediaStreamSource::Capabilities capabilities;
+    capabilities.device_id = id;
+    capabilities.echo_cancellation.emplace_back(false);
+    capabilities.auto_gain_control.emplace_back(false);
+    capabilities.noise_suppression.emplace_back(false);
+    capabilities.around_audio_processing.emplace_back(false);
+    capabilities.sample_size = {
+        media::SampleFormatToBitsPerChannel(media::kSampleFormatS16),  // min
+        media::SampleFormatToBitsPerChannel(media::kSampleFormatS16)   // max
+    };
+    media_stream_source->SetCapabilities(capabilities);
+    media_stream_audio_source->ConnectToTrack(media_stream_component);
+
+    return MakeGarbageCollected<MediaStreamTrack>(GetExecutionContext(), media_stream_component);
+  }
   return nullptr;
 }
 

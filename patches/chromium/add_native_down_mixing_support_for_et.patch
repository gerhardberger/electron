+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_MEDIASTREAM_AROUND_AUDIO_MIXER_H
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_MEDIASTREAM_AROUND_AUDIO_MIXER_H
+
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/public/platform/modules/mediastream/web_media_stream_audio_sink.h"
+#include "third_party/blink/renderer/platform/webrtc/webrtc_source.h"
+#include "third_party/webrtc/api/audio/audio_mixer.h"
+#include "third_party/webrtc/rtc_base/synchronization/mutex.h"
+
+namespace media {
+class AudioBus;
+class AudioParameters;
+}
+
+namespace blink {
+
+class MediaStreamAudioSource;
+class WebRtcAudioDeviceImpl;
+
+class AroundAudioMixer
+    : public webrtc::AudioMixer,
+      public WebMediaStreamAudioSink,
+      public webrtc::AudioMixer::Source,
+      public WebRtcPlayoutDataSource::Sink {
+ public:
+  AroundAudioMixer();
+
+  // AudioMixer implementation
+  bool AddSource(webrtc::AudioMixer::Source* audio_source) override;
+  void RemoveSource(webrtc::AudioMixer::Source* audio_source) override;
+  void Mix(size_t number_of_channels,
+           webrtc::AudioFrame* audio_frame_for_mixing) override;
+  std::vector<webrtc::AudioMixer::Source*> audio_sources() override;
+
+  // WebMediaStreamAudioSink implementation.
+  void OnData(const media::AudioBus& audio_bus,
+              base::TimeTicks estimated_capture_time) override;
+  void OnSetFormat(const media::AudioParameters& params) override;
+  void OnReadyStateChanged(WebMediaStreamSource::ReadyState state) override;
+
+  // AudioMixer::Source implementation.
+  webrtc::AudioMixer::Source::AudioFrameInfo
+    GetAudioFrameWithInfo(int sample_rate_hz,
+                          webrtc::AudioFrame* audio_frame) override;
+  int Ssrc() const override;
+  int PreferredSampleRate() const override;
+
+  // WebRtcPlayoutDataSource::Sink implementation.
+  void OnPlayoutData(media::AudioBus* audio_bus,
+                     int sample_rate,
+                     base::TimeDelta audio_delay) override;
+  void OnPlayoutDataSourceChanged() override;
+  void OnRenderThreadChanged() override;
+
+  // AroundAudioMixer
+  void ConnectDestination(MediaStreamAudioSource* destination,
+                          WebRtcAudioDeviceImpl* audio_device);
+  void ConnectLocalMicrophone(const WebMediaStreamTrack& track, int delay);
+  void DisconnectLocalMicrophone(const WebMediaStreamTrack& track);
+
+ private:
+  void DriveWithPlayback(bool value);
+  void MixMicrophoneInputsAndDeliverToDestination();
+
+  MediaStreamAudioSource* destination_ = nullptr;
+  bool have_set_destination_format_ = false;
+  rtc::scoped_refptr<webrtc::AudioMixer> playback_mixer_;
+  rtc::scoped_refptr<webrtc::AudioMixer> microphone_mixer_;
+  webrtc::AudioFrame mixed_frame_;
+  Vector<int16_t> delay_buffer_;
+  int delay_index_ = 0;
+  int delay_ = 0;
+  std::unique_ptr<media::AudioBus> audio_bus_;
+  mutable webrtc::Mutex mutex_;
+  WebRtcAudioDeviceImpl* playback_device_ = nullptr;
+};
+
+}
+
+#endif  //THIRD_PARTY_BLINK_RENDERER_MODULES_MEDIASTREAM_AROUND_AUDIO_MIXER_H

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gellert <gellert.hegyi@around.co>
Date: Fri, 13 Aug 2021 01:19:48 +0200
Subject: add switch to control minimum audio frame size

This patch adds a switch to control minimum audio frame size.

diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
index d244ec871c7c86e7da19b5c2892dd42980fb97a3..7caa95301c5e7325b53085029e7c8e2b581acbe3 100644
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -3424,6 +3424,7 @@ void RenderProcessHostImpl::PropagateBrowserCommandLineToRenderer(
     switches::kAllowLoopbackInPeerConnection,
     switches::kAndroidFontsPath,
     switches::kAudioBufferSize,
+    switches::kAudioLatencyFactor,
     switches::kAutoplayPolicy,
     switches::kMojoCoreLibraryPath,
     switches::kCrossOriginWebAssemblyModuleSharingAllowed,
diff --git a/content/browser/utility_process_host.cc b/content/browser/utility_process_host.cc
index 9230b5c64934d736f2fc01828560e0af027887fc..a295f3745dd107e4eb46fc0a58845c4aedbacb52 100644
--- a/content/browser/utility_process_host.cc
+++ b/content/browser/utility_process_host.cc
@@ -268,6 +268,7 @@ bool UtilityProcessHost::StartProcess() {
       switches::kEnableExperimentalWebPlatformFeatures,
       // These flags are used by the audio service:
       switches::kAudioBufferSize,
+      switches::kAudioLatencyFactor,
       switches::kAudioServiceQuitTimeoutMs,
       switches::kDisableAudioOutput,
       switches::kFailAudioStreamCreation,
diff --git a/media/audio/mac/audio_manager_mac.cc b/media/audio/mac/audio_manager_mac.cc
index d6e08b56420077bbdddd81c12a535fea62197aca..ca2f002c36d9d336af828a104ebd623845a5c6d9 100644
--- a/media/audio/mac/audio_manager_mac.cc
+++ b/media/audio/mac/audio_manager_mac.cc
@@ -20,6 +20,7 @@
 #include "base/memory/free_deleter.h"
 #include "base/power_monitor/power_monitor.h"
 #include "base/power_monitor/power_observer.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/strings/sys_string_conversions.h"
 #include "base/threading/thread_checker.h"
 #include "media/audio/audio_device_description.h"
@@ -1040,6 +1041,17 @@ bool AudioManagerMac::MaybeChangeBufferSize(AudioDeviceID device_id,
   }
   DVLOG(1) << "valid IO buffer size range: [" << minimum << ", " << maximum
            << "]";
+  const base::CommandLine* cmd_line = base::CommandLine::ForCurrentProcess();
+  int audio_latency_factor = 0;
+  std::string audio_latency_factor_str(cmd_line->GetSwitchValueASCII(
+      switches::kAudioLatencyFactor));
+  if (base::StringToInt(audio_latency_factor_str, &audio_latency_factor) && audio_latency_factor > 0) {
+    int base_frame_size = HardwareSampleRateForDevice(device_id) / 100;
+    for (int i = 1; i <= audio_latency_factor && i * base_frame_size <= (int)maximum; i++) {
+        minimum = i * base_frame_size;
+    }
+    DVLOG(1) << switches::kAudioLatencyFactor << ": " << audio_latency_factor << ", minimum: " << minimum;
+  }
   buffer_size = desired_buffer_size;
   if (buffer_size < minimum)
     buffer_size = minimum;
diff --git a/media/base/media_switches.cc b/media/base/media_switches.cc
index 5f43904c668ffed2c6471b1da41d4c53033551c7..271481a22b14f814666957dcd68857856cba3634 100644
--- a/media/base/media_switches.cc
+++ b/media/base/media_switches.cc
@@ -19,6 +19,10 @@
 
 namespace switches {
 
+// Allow users to specify a custom buffer size in 10ms multiples.
+// 0 is default, 1 - 10ms, 2 - 20ms, etc.
+const char kAudioLatencyFactor[] = "audio-latency-factor";
+
 // Allow users to specify a custom buffer size for debugging purpose.
 const char kAudioBufferSize[] = "audio-buffer-size";
 
diff --git a/media/base/media_switches.h b/media/base/media_switches.h
index e09620e46251d1fa1121064caf5d34c67dadd5ee..056cd95a6e7a8365fad52ce8a1869927e6f4f028 100644
--- a/media/base/media_switches.h
+++ b/media/base/media_switches.h
@@ -22,6 +22,8 @@ class CommandLine;
 
 namespace switches {
 
+MEDIA_EXPORT extern const char kAudioLatencyFactor[];
+
 MEDIA_EXPORT extern const char kAudioBufferSize[];
 
 MEDIA_EXPORT extern const char kAudioServiceQuitTimeoutMs[];

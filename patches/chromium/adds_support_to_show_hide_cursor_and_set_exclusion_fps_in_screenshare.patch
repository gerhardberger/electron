From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gellert <gellert.hegyi@around.co>
Date: Thu, 12 Aug 2021 19:23:53 +0200
Subject: adds support to show hide cursor and set exclusion fps in screenshare

This patch adds support using the around-dc datachannel solution to show or hide the cursor and set exclusion fps in screensharing.

diff --git a/content/browser/media/capture/desktop_capture_device.cc b/content/browser/media/capture/desktop_capture_device.cc
index 48a40231a248327b8adc4a207fbe3f767ba2b6c6..2cc644352b2f64a4553f58a1f26a46087f466789 100644
--- a/content/browser/media/capture/desktop_capture_device.cc
+++ b/content/browser/media/capture/desktop_capture_device.cc
@@ -124,6 +124,10 @@ class DesktopCaptureDevice::Core : public webrtc::DesktopCapturer::Callback {
   void AllocateAndStart(const media::VideoCaptureParams& params,
                         std::unique_ptr<Client> client);
 
+  void SetCursor(bool show);
+
+  void SetExclusionFps(float fps);
+
   void SetNotificationWindowId(gfx::NativeViewId window_id);
 
   void SetMockTimeForTesting(
@@ -237,6 +241,14 @@ DesktopCaptureDevice::Core::~Core() {
   desktop_capturer_.reset();
 }
 
+void DesktopCaptureDevice::Core::SetCursor(bool show) {
+  desktop_capturer_->show_cursor_ = show;
+}
+
+void DesktopCaptureDevice::Core::SetExclusionFps(float fps) {
+  desktop_capturer_->exclusion_fps_ = fps;
+}
+
 void DesktopCaptureDevice::Core::AllocateAndStart(
     const media::VideoCaptureParams& params,
     std::unique_ptr<Client> client) {
@@ -265,6 +277,7 @@ void DesktopCaptureDevice::Core::AllocateAndStart(
   RequestWakeLock();
 
   desktop_capturer_->should_exclude_ = true;
+  desktop_capturer_->show_cursor_ = params.show_cursor;
   desktop_capturer_->Start(this);
   // Assume it will be always started successfully for now.
   client_->OnStarted();
@@ -584,6 +597,20 @@ DesktopCaptureDevice::~DesktopCaptureDevice() {
   DCHECK(!core_);
 }
 
+void DesktopCaptureDevice::SetCursor(bool show) {
+  thread_.task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&Core::SetCursor, base::Unretained(core_.get()),
+                     show));
+}
+
+void DesktopCaptureDevice::SetExclusionFps(float fps) {
+  thread_.task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&Core::SetExclusionFps, base::Unretained(core_.get()),
+                     fps));
+}

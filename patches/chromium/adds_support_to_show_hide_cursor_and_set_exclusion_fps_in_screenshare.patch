+void VideoCaptureImpl::OnCommandReceived(std::string command, std::map<std::string, std::string> params) {
+  if (command == "cursor_visibility") {
+    bool show_cursor = params["show"] == "true";
+
+    Platform::Current()->GetIOTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VideoCaptureImpl::SetCursor, weak_factory_.GetWeakPtr(), show_cursor));
+  }
+
+  if (command == "set_screenshare_exclusion") {
+    absl::optional<float> value = rtc::StringToNumber<float>(params["fps"]);
+
+    if (!value.has_value()) {
+      return;
+    }
+
+    float exclusion_fps = value.value();
+
+    Platform::Current()->GetIOTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&VideoCaptureImpl::SetExclusionFps, weak_factory_.GetWeakPtr(), exclusion_fps));
+  }
+}

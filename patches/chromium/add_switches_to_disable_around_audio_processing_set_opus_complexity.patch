From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gellert <gellert.hegyi@around.co>
Date: Fri, 13 Aug 2021 10:25:31 +0200
Subject: Add switches to disable Around audio processing, set opus complexity
 and disable audio encoder queue

Add switches to disable Around audio processing, set opus complexity and disable audio encoder queue.

diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
index b42fe6397921ec694216776b7c05a188f16d075b..441febf2cc00648ca8242129a750a26e83010799 100644
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -3407,6 +3407,9 @@ void RenderProcessHostImpl::PropagateBrowserCommandLineToRenderer(
     switches::kAndroidFontsPath,
     switches::kAudioBufferSize,
     switches::kAudioLatencyFactor,
+    switches::kDisableAroundAudioProcessing,
+    switches::kOpusComplexity,
+    switches::kDisableEncoderQueue,
     switches::kAutoplayPolicy,
     switches::kMojoCoreLibraryPath,
     switches::kDisable2dCanvasImageChromium,
diff --git a/content/browser/utility_process_host.cc b/content/browser/utility_process_host.cc
index df018de76a44847d85358628c021117a1f16f1b6..05d8c8509bc9064c60bcd58146ddf56fc472bec5 100644
--- a/content/browser/utility_process_host.cc
+++ b/content/browser/utility_process_host.cc
@@ -273,6 +273,9 @@ bool UtilityProcessHost::StartProcess() {
       // These flags are used by the audio service:
       switches::kAudioBufferSize,
       switches::kAudioLatencyFactor,
+      switches::kDisableAroundAudioProcessing,
+      switches::kOpusComplexity,
+      switches::kDisableEncoderQueue,
       switches::kAudioServiceQuitTimeoutMs,
       switches::kDisableAudioOutput,
       switches::kFailAudioStreamCreation,
diff --git a/media/base/media_switches.cc b/media/base/media_switches.cc
index 93ed2d58f274ea9ed88ae591743e7d8b440e7eba..f9ed300ca34f0e41b3b63add3191ce3be05eea38 100644
--- a/media/base/media_switches.cc
+++ b/media/base/media_switches.cc
@@ -23,6 +23,15 @@ namespace switches {
 // 0 is default, 1 - 10ms, 2 - 20ms, etc.
 const char kAudioLatencyFactor[] = "audio-latency-factor";
 
+// Disable Around audio processing.
+const char kDisableAroundAudioProcessing[] = "disable-around-audio-processing";
+
+// Sets opus complexity 0-9.
+const char kOpusComplexity[] = "opus-complexity";
+
+// Moves Opus encoding from worker threads to capture thread.
+const char kDisableEncoderQueue[] = "disable-encoder-queue";
+
 // Allow users to specify a custom buffer size for debugging purpose.
 const char kAudioBufferSize[] = "audio-buffer-size";
 
diff --git a/media/base/media_switches.h b/media/base/media_switches.h
index 38ebd21fd27d7bc9d330c31aca66822f20cb4fe4..ddf82f52d50f8a46dac818a7d636b3a88cdbd27d 100644
--- a/media/base/media_switches.h
+++ b/media/base/media_switches.h
@@ -23,6 +23,9 @@ class CommandLine;
 namespace switches {
 
 MEDIA_EXPORT extern const char kAudioLatencyFactor[];
+MEDIA_EXPORT extern const char kDisableAroundAudioProcessing[];
+MEDIA_EXPORT extern const char kOpusComplexity[];
+MEDIA_EXPORT extern const char kDisableEncoderQueue[];
 
 MEDIA_EXPORT extern const char kAudioBufferSize[];
 
diff --git a/third_party/blink/renderer/modules/mediastream/media_stream_audio_processor.cc b/third_party/blink/renderer/modules/mediastream/media_stream_audio_processor.cc
index e4e7d7e38ffb6699cef682437358a41aff99d638..46c1a5e1bb693728dfcd4ccc2e4918fa52deb0aa 100644
--- a/third_party/blink/renderer/modules/mediastream/media_stream_audio_processor.cc
+++ b/third_party/blink/renderer/modules/mediastream/media_stream_audio_processor.cc
@@ -27,6 +27,7 @@
 #include "media/base/audio_parameters.h"
 #include "media/base/channel_layout.h"
 #include "media/base/limits.h"
+#include "media/base/media_switches.h"
 #include "media/webrtc/helpers.h"
 #include "third_party/abseil-cpp/absl/types/optional.h"
 #include "third_party/blink/public/common/features.h"
@@ -577,6 +578,12 @@ void MediaStreamAudioProcessor::InitializeCaptureFifo(
   // The output channels from the fifo is normally the same as input.
   int fifo_output_channels = input_format.channels();
 
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kDisableAroundAudioProcessing)) {
+    auto config = audio_processing_->GetConfig();
+    config.around_audio_processing.enabled = false;
+    audio_processing_->ApplyConfig(config);
+  }
+
   bool aroundAudioProcessingEnabled = audio_processing_->GetConfig().around_audio_processing.enabled;
 
   media::ChannelLayout output_channel_layout;

+Local<Array> CreatePlasticityModuleArguments(
+    Isolate* isolate,
+    Local<Context> context,
+    Local<String> module_filename,
+    Local<String> module_directory) {
+  Local<Array> module_arguments;
+  VIRTUALIZER_START
+  Environment* env = Environment::GetCurrent(context);
+  Local<Value> module_name = String::NewFromUtf8Literal(isolate, "module");
+  Local<Value> module_builtin;
+  if (!env->builtin_module_require()
+           ->Call(context, Undefined(isolate), 1, &module_name)
+           .ToLocal(&module_builtin))
+    FAIL();
+  Local<Value> create_require;
+  if (!module_builtin.As<Object>()
+           ->Get(context, String::NewFromUtf8Literal(isolate, "createRequire"))
+           .ToLocal(&create_require))
+    FAIL();
+  Local<Value> require_argument = module_filename;
+  Local<Value> require;
+  if (!create_require.As<Function>()
+           ->Call(context, module_builtin, 1, &require_argument)
+           .ToLocal(&require))
+    FAIL();
+  Local<Object> module = Object::New(isolate);
+  Local<Object> exports = Object::New(isolate);
+  if (module->Set(context, env->exports_string(), exports).IsNothing())
+    FAIL();
+  module_arguments = Array::New(isolate, 7);
+  if (module_arguments->Set(context, 0, exports).IsNothing() ||
+      module_arguments->Set(context, 1, require).IsNothing() ||
+      module_arguments->Set(context, 2, module).IsNothing() ||
+      module_arguments->Set(context, 3, module_filename).IsNothing() ||
+      module_arguments->Set(context, 4, module_directory).IsNothing() ||
+      module_arguments->Set(context, 5, env->process_object()).IsNothing() ||
+      module_arguments->Set(context, 6, context->Global()).IsNothing())
